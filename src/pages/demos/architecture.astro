    <!-- =====================================================================
         11. INTERACTIVE SCRIPTS (SLIDER, CALCULATOR, STYLE JUMP, MODAL)
         ===================================================================== -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        // 1. Mobile Navigation Toggle
        const mobileBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const mobileLinks = document.querySelectorAll('.mobile-nav-link');

        if (mobileBtn && mobileMenu) {
          mobileBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
          });
          mobileLinks.forEach((link) => {
            link.addEventListener('click', () => mobileMenu.classList.add('hidden'));
          });
        }

        // 2. Interactive Before / After Real Construction Slider
        const sliderContainer = document.getElementById('slider-container');
        const sliderDivider = document.getElementById('slider-divider');
        const presetBtns = document.querySelectorAll('.slider-preset-btn');
        let isDragging = false;

        function setSliderPosition(percent) {
          const clamped = Math.max(2, Math.min(98, percent));
          if (sliderContainer) {
            sliderContainer.style.setProperty('--slider-pos', clamped + '%');
            sliderContainer.setAttribute('aria-valuenow', String(Math.round(clamped)));
          }
          if (sliderDivider) {
            sliderDivider.style.left = clamped + '%';
          }
        }

        function handlePointerMove(e) {
          if (!isDragging || !sliderContainer) return;
          const rect = sliderContainer.getBoundingClientRect();
          const clientX = e.touches ? e.touches[0].clientX : e.clientX;
          const percent = ((clientX - rect.left) / rect.width) * 100;
          setSliderPosition(percent);
        }

        if (sliderContainer) {
          sliderContainer.addEventListener('mousedown', (e) => {
            isDragging = true;
            handlePointerMove(e);
          });
          window.addEventListener('mousemove', handlePointerMove);
          window.addEventListener('mouseup', () => {
            isDragging = false;
          });

          sliderContainer.addEventListener(
            'touchstart',
            (e) => {
              isDragging = true;
              handlePointerMove(e);
            },
            { passive: true }
          );
          window.addEventListener('touchmove', handlePointerMove, { passive: true });
          window.addEventListener('touchend', () => {
            isDragging = false;
          });

          sliderContainer.addEventListener('keydown', (e) => {
            const current =
              parseFloat(sliderContainer.style.getPropertyValue('--slider-pos')) || 50;
            if (e.key === 'ArrowLeft') setSliderPosition(current - 5);
            if (e.key === 'ArrowRight') setSliderPosition(current + 5);
          });
        }

        presetBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            const targetPos = parseFloat(btn.getAttribute('data-pos') || '50');
            setSliderPosition(targetPos);
            presetBtns.forEach((b) => {
              b.className =
                'slider-preset-btn px-4 py-2.5 border border-white/20 text-white/75 hover:border-[#d4a373] hover:text-white transition-all cursor-pointer';
            });
            btn.className =
              'slider-preset-btn px-4 py-2.5 bg-[#d4a373] text-[#08090c] font-semibold transition-all cursor-pointer';
          });
        });

        // 3. Bespoke Feasibility & Cost Calculator
        const styleBtns = document.querySelectorAll('.calc-style-btn');
        const tierBtns = document.querySelectorAll('.calc-tier-btn');
        const areaSlider = document.getElementById('area-slider');
        const areaValDisplay = document.getElementById('calc-area-val');

        const selectedStyleTitle = document.getElementById('calc-selected-style-title');
        const totalUsdDisplay = document.getElementById('calc-total-usd');
        const totalVndDisplay = document.getElementById('calc-total-vnd');
        const unitRateDisplay = document.getElementById('calc-unit-rate');
        const designTimeDisplay = document.getElementById('calc-design-time');
        const buildTimeDisplay = document.getElementById('calc-build-time');

        const allocStructVal = document.getElementById('alloc-struct-val');
        const allocStructBar = document.getElementById('alloc-struct-bar');
        const allocFinishVal = document.getElementById('alloc-finish-val');
        const allocFinishBar = document.getElementById('alloc-finish-bar');
        const allocGlassVal = document.getElementById('alloc-glass-val');
        const allocGlassBar = document.getElementById('alloc-glass-bar');
        const allocPoolVal = document.getElementById('alloc-pool-val');
        const allocPoolBar = document.getElementById('alloc-pool-bar');

        const clientStyleSelect = document.getElementById('client-style');
        const clientPlotInput = document.getElementById('client-plot-area');

        let activeStyle = {
          name: 'Tropical Brutalism (Villa)',
          rate: 1280,
          designMonths: 3.5,
          buildMonths: 14,
          pctStruct: 34,
          pctFinish: 28,
          pctGlass: 20,
          pctPool: 18,
        };
        let activeTierMult = 1.0;

        function updateCalculator() {
          const area = parseInt(areaSlider?.value || '450', 10);
          if (areaValDisplay) areaValDisplay.textContent = String(area);

          const effectiveRate = Math.round(activeStyle.rate * activeTierMult);
          const totalUSD = area * effectiveRate;
          const totalVND = ((totalUSD * 25400) / 1e9).toFixed(1);

          // Scale build time slightly for larger estates
          const areaFactor = area > 600 ? 2 : area < 250 ? -1 : 0;
          const finalBuildMonths = activeStyle.buildMonths + areaFactor;

          if (selectedStyleTitle) selectedStyleTitle.textContent = activeStyle.name;
          if (totalUsdDisplay) totalUsdDisplay.textContent = '$' + totalUSD.toLocaleString('en-US') + ' USD';
          if (totalVndDisplay) totalVndDisplay.textContent = '≈ ' + totalVND + ' Billion VND';
          if (unitRateDisplay) unitRateDisplay.textContent = 'Unit Rate: $' + effectiveRate.toLocaleString('en-US') + ' / m²';
          if (designTimeDisplay) designTimeDisplay.textContent = activeStyle.designMonths + ' Months';
          if (buildTimeDisplay) buildTimeDisplay.textContent = finalBuildMonths + ' Months';

          // Breakdown calculations
          const structUSD = Math.round((totalUSD * activeStyle.pctStruct) / 100);
          const finishUSD = Math.round((totalUSD * activeStyle.pctFinish) / 100);
          const glassUSD = Math.round((totalUSD * activeStyle.pctGlass) / 100);
          const poolUSD = Math.round((totalUSD * activeStyle.pctPool) / 100);

          if (allocStructVal) allocStructVal.textContent = '$' + structUSD.toLocaleString('en-US') + ' (' + activeStyle.pctStruct + '%)';
          if (allocStructBar) allocStructBar.style.width = activeStyle.pctStruct + '%';

          if (allocFinishVal) allocFinishVal.textContent = '$' + finishUSD.toLocaleString('en-US') + ' (' + activeStyle.pctFinish + '%)';
          if (allocFinishBar) allocFinishBar.style.width = activeStyle.pctFinish + '%';

          if (allocGlassVal) allocGlassVal.textContent = '$' + glassUSD.toLocaleString('en-US') + ' (' + activeStyle.pctGlass + '%)';
          if (allocGlassBar) allocGlassBar.style.width = activeStyle.pctGlass + '%';

          if (allocPoolVal) allocPoolVal.textContent = '$' + poolUSD.toLocaleString('en-US') + ' (' + activeStyle.pctPool + '%)';
          if (allocPoolBar) allocPoolBar.style.width = activeStyle.pctPool + '%';

          // Sync with inquiry form
          if (clientPlotInput) {
            clientPlotInput.value = area + ' m² Gross Floor Area (Est. $' + totalUSD.toLocaleString('en-US') + ')';
          }
        }

        function activateStyleButton(index) {
          const targetBtn = styleBtns[index];
          if (!targetBtn) return;

          styleBtns.forEach((b) => {
            b.className =
              'calc-style-btn p-4 border text-left transition-all cursor-pointer border-white/15 bg-white/[0.02] text-white/70 hover:border-white/40 hover:text-white';
          });
          targetBtn.className =
            'calc-style-btn p-4 border text-left transition-all cursor-pointer border-[#d4a373] bg-[#d4a373]/15 text-white';

          activeStyle = {
            name: targetBtn.getAttribute('data-name') || 'Tropical Brutalism (Villa)',
            rate: parseFloat(targetBtn.getAttribute('data-rate') || '1280'),
            designMonths: parseFloat(targetBtn.getAttribute('data-design-months') || '3.5'),
            buildMonths: parseInt(targetBtn.getAttribute('data-build-months') || '14', 10),
            pctStruct: parseInt(targetBtn.getAttribute('data-pct-struct') || '34', 10),
            pctFinish: parseInt(targetBtn.getAttribute('data-pct-finish') || '28', 10),
            pctGlass: parseInt(targetBtn.getAttribute('data-pct-glass') || '20', 10),
            pctPool: parseInt(targetBtn.getAttribute('data-pct-pool') || '18', 10),
          };

          if (clientStyleSelect && clientStyleSelect.options[index]) {
            clientStyleSelect.selectedIndex = index;
          }

          updateCalculator();
        }

        styleBtns.forEach((btn, idx) => {
          btn.addEventListener('click', () => activateStyleButton(idx));
        });

        // "Calculate This Style" buttons inside the 4 Showcase Frames
        const frameCalcBtns = document.querySelectorAll('.select-style-calc-btn');
        frameCalcBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            const idx = parseInt(btn.getAttribute('data-style-index') || '0', 10);
            activateStyleButton(idx);
            const calcSection = document.getElementById('calculator');
            if (calcSection) {
              calcSection.scrollIntoView({ behavior: 'smooth' });
            }
          });
        });

        tierBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            activeTierMult = parseFloat(btn.getAttribute('data-mult') || '1.0');
            tierBtns.forEach((b) => {
              b.className =
                'calc-tier-btn p-3.5 border text-left transition-all cursor-pointer border-white/15 bg-white/[0.02] text-white/70 hover:text-white';
            });
            btn.className =
              'calc-tier-btn p-3.5 border text-left transition-all cursor-pointer border-[#d4a373] bg-[#d4a373]/15 text-white';
            updateCalculator();
          });
        });

        if (areaSlider) {
          areaSlider.addEventListener('input', updateCalculator);
        }

        updateCalculator();

        // 4. Consultation Form & Instant Reference Modal
        const inquiryForm = document.getElementById('arch-inquiry-form');
        const modal = document.getElementById('consultation-modal');
        const closeModalBtn = document.getElementById('close-modal-btn');
        const modalClientName = document.getElementById('modal-client-name');
        const modalStyle = document.getElementById('modal-style');
        const modalLocation = document.getElementById('modal-location');
        const modalArea = document.getElementById('modal-area');
        const modalRefCode = document.getElementById('modal-ref-code');

        if (inquiryForm && modal) {
          inquiryForm.addEventListener('submit', (e) => {
            e.preventDefault();
            const nameVal = document.getElementById('client-name')?.value || 'Valued Client';
            const styleVal = document.getElementById('client-style')?.value || activeStyle.name;
            const locVal = document.getElementById('client-location')?.value || 'Da Nang / Hoi An';
            const areaVal = document.getElementById('client-plot-area')?.value || '450 m²';
            const randomRef = 'REF: MNL-2026-' + Math.floor(100 + Math.random() * 900);

            if (modalClientName) modalClientName.textContent = nameVal;
            if (modalStyle) modalStyle.textContent = styleVal;
            if (modalLocation) modalLocation.textContent = locVal;
            if (modalArea) modalArea.textContent = areaVal;
            if (modalRefCode) modalRefCode.textContent = randomRef;

            modal.classList.remove('hidden');
            modal.classList.add('flex');
          });
        }

        if (closeModalBtn && modal) {
          closeModalBtn.addEventListener('click', () => {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
          });
        }

        // 5. Scroll to Top
        const topBtn = document.getElementById('arch-top-btn');
        if (topBtn) {
          topBtn.addEventListener('click', () => {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        }
      });
    </script>
