---
import '../../styles/global.css';
// MONOLITH ARCHITECTS — Contemporary & Tropical Luxury Residential Architecture
// Specializing in 4 Distinct Architectural Typologies across Da Nang, Hoi An & Central Coast Vietnam
// Live Showcase Demo 02 for Portfolio Dang Van Bao Tuan
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MONOLITH ARCHITECTS — Contemporary & Tropical Luxury Residential Architecture</title>
    <meta
      name="description"
      content="Monolith Architects — Crafting bespoke coastal villas, raw tropical monoliths, and light-filled urban retreats. Specialized in 4 Distinct Architectural Typologies across Da Nang, Hoi An, and Central Coast Vietnam."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts: Space Grotesk, Plus Jakarta Sans, Cormorant Garamond & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=JetBrains+Mono:wght@300;400;500&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <style>
      :root {
        --bg-obsidian: #08090c;
        --bg-monolith: #101217;
        --bg-stone: #161920;
        --text-pure: #f8fafc;
        --text-muted: #94a3b8;
        --accent-gold: #d4a373;
        --accent-sand: #e6ccb2;
        --accent-emerald: #10b981;

        --font-display: 'Space Grotesk', sans-serif;
        --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
        --font-serif: 'Cormorant Garamond', Georgia, serif;
        --font-mono: 'JetBrains Mono', monospace;
      }

      body {
        background-color: var(--bg-obsidian);
        color: var(--text-pure);
        font-family: var(--font-sans);
        margin: 0;
        padding: 0;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
      }

      .font-display {
        font-family: var(--font-display);
      }
      .font-serif-editorial {
        font-family: var(--font-serif);
      }
      .font-mono-spec {
        font-family: var(--font-mono);
      }

      /* Subtle Architectural Blueprint Grid */
      .arch-grid-bg {
        background-color: var(--bg-obsidian);
        background-image:
          linear-gradient(to right, rgba(255, 255, 255, 0.025) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
        background-size: 72px 72px;
      }

      /* Before / After Clip Mask */
      .slider-after-layer {
        clip-path: inset(0 0 0 var(--slider-pos, 50%));
      }

      /* Custom Range Slider */
      input[type='range'].arch-range {
        -webkit-appearance: none;
        appearance: none;
        background: rgba(255, 255, 255, 0.15);
        height: 4px;
        border-radius: 999px;
        outline: none;
      }

      input[type='range'].arch-range::-webkit-slider-thumb {
        -webkit-appearance: none;
        appearance: none;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: #d4a373;
        border: 3px solid #08090c;
        box-shadow: 0 0 0 2px rgba(212, 163, 115, 0.6), 0 4px 12px rgba(0, 0, 0, 0.5);
        cursor: grab;
        transition: transform 0.2s ease, background-color 0.2s ease;
      }

      input[type='range'].arch-range::-webkit-slider-thumb:hover {
        transform: scale(1.12);
        background: #e6ccb2;
      }

      input[type='range'].arch-range::-webkit-slider-thumb:active {
        cursor: grabbing;
        transform: scale(1.2);
      }

      /* Architectural Form Input */
      .arch-input {
        width: 100%;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.14);
        padding: 14px 16px;
        color: #ffffff;
        font-family: var(--font-sans);
        font-size: 0.95rem;
        outline: none;
        transition: all 0.25s ease;
      }

      .arch-input:focus {
        border-color: #d4a373;
        background: rgba(212, 163, 115, 0.05);
      }

      .arch-input::placeholder {
        color: rgba(148, 163, 184, 0.45);
      }

      /* Image zoom effect inside frames */
      .typology-frame:hover .typology-img {
        transform: scale(1.04);
      }
    </style>
  </head>

  <body class="arch-grid-bg antialiased min-h-screen flex flex-col selection:bg-[#d4a373] selection:text-[#08090c]">
    <!-- =====================================================================
         1. TOP PORTFOLIO RETURN BAR (STICKY)
         ===================================================================== -->
    <aside
      class="sticky top-0 z-50 w-full bg-[#08090c]/95 text-[#f8fafc] border-b border-white/10 backdrop-blur-md px-4 sm:px-8 lg:px-12 py-3"
      aria-label="Portfolio Return Navigation"
    >
      <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2 text-xs">
        <a
          href="/#projects"
          class="inline-flex items-center gap-3 text-white/85 hover:text-[#d4a373] font-medium transition-colors group tracking-wide cursor-pointer"
        >
          <span class="inline-block transition-transform group-hover:-translate-x-1.5 text-[#d4a373]">←</span>
          <span>Back to Portfolio — Dang Van Bao Tuan</span>
          <span class="text-white/20 hidden sm:inline">/</span>
          <span class="text-[#d4a373] text-[11px] hidden sm:inline font-mono-spec uppercase">
            Live Showcase 02 • Residential Architecture Studio
          </span>
        </a>

        <div class="flex items-center gap-3 text-[11px] font-mono-spec text-white/60 tracking-widest uppercase">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>4 SIGNATURE HOME STYLES</span>
          <span>•</span>
          <span class="hidden md:inline text-white/80">DA NANG • HOI AN • CENTRAL COAST</span>
        </div>
      </div>
    </aside>

    <!-- =====================================================================
         2. STUDIO NAVIGATION HEADER
         ===================================================================== -->
    <header class="w-full bg-[#08090c]/85 backdrop-blur-xl border-b border-white/10 sticky top-[45px] sm:top-[41px] z-40">
      <div class="max-w-7xl mx-auto px-4 sm:px-8 lg:px-12 h-20 flex items-center justify-between">
        <a href="#hero" class="flex items-center gap-3.5 group text-left cursor-pointer">
          <div class="w-10 h-10 border border-[#d4a373]/60 bg-[#d4a373]/10 flex items-center justify-center font-display font-bold text-sm tracking-widest text-[#d4a373] group-hover:bg-[#d4a373] group-hover:text-[#08090c] transition-all duration-300">
            M
          </div>
          <div>
            <span class="font-display text-sm sm:text-base font-bold tracking-[0.22em] text-white block uppercase">
              MONOLITH ARCHITECTS
            </span>
            <span class="text-[10px] font-mono-spec tracking-[0.16em] text-[#d4a373] uppercase block mt-0.5">
              TROPICAL &amp; CONTEMPORARY LUXURY HOMES
            </span>
          </div>
        </a>

        <nav class="hidden lg:flex items-center gap-8 text-xs font-mono-spec tracking-[0.16em] text-white/70 uppercase" aria-label="Main Navigation">
          <a href="#typologies" class="hover:text-[#d4a373] transition-colors py-1">01. 4 Home Styles</a>
          <a href="#transformation" class="hover:text-[#d4a373] transition-colors py-1">02. Before / After</a>
          <a href="#calculator" class="hover:text-[#d4a373] transition-colors py-1">03. Cost Calculator</a>
          <a href="#process" class="hover:text-[#d4a373] transition-colors py-1">04. Build Process</a>
          <a href="#consultation" class="hover:text-[#d4a373] transition-colors py-1">05. Commission</a>
        </nav>

        <div class="hidden sm:flex items-center gap-4">
          <a
            href="#calculator"
            class="inline-flex items-center gap-2 px-4 py-2.5 border border-white/20 text-white/85 hover:border-[#d4a373] hover:text-[#d4a373] text-xs font-mono-spec uppercase tracking-[0.14em] transition-all cursor-pointer"
          >
            <span>Estimate Budget</span>
          </a>
          <a
            href="#consultation"
            class="inline-flex items-center gap-2 px-5 py-2.5 bg-[#d4a373] text-[#08090c] hover:bg-[#e6ccb2] text-xs font-mono-spec font-semibold uppercase tracking-[0.15em] transition-all cursor-pointer"
          >
            <span>Book Architect</span>
          </a>
        </div>

        <button
          id="mobile-menu-btn"
          type="button"
          class="lg:hidden p-2.5 text-white/80 hover:text-white transition-colors cursor-pointer"
          aria-label="Toggle Menu"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 7h16M4 15h16" />
          </svg>
        </button>
      </div>

      <!-- Mobile Dropdown -->
      <div id="mobile-menu" class="hidden lg:hidden border-t border-white/10 bg-[#08090c] px-6 py-6 space-y-4 font-mono-spec text-xs tracking-[0.18em] uppercase">
        <a href="#typologies" class="mobile-nav-link block py-2 text-white/80 hover:text-[#d4a373]">01. The 4 Architectural Typologies</a>
        <a href="#transformation" class="mobile-nav-link block py-2 text-white/80 hover:text-[#d4a373]">02. Before / After Site Transformation</a>
        <a href="#calculator" class="mobile-nav-link block py-2 text-white/80 hover:text-[#d4a373]">03. Bespoke Cost Calculator</a>
        <a href="#process" class="mobile-nav-link block py-2 text-white/80 hover:text-[#d4a373]">04. 4-Stage Design &amp; Build Process</a>
        <a href="#consultation" class="mobile-nav-link block py-2 text-[#d4a373] font-semibold">05. Request Custom Home Dossier</a>
      </div>
    </header>
    <main class="flex-1">
      <!-- =====================================================================
           3. HERO SECTION: FULL-SCREEN LUXURY TROPICAL VILLA + 4 QUICK STYLE CARDS
           ===================================================================== -->
      <section id="hero" class="relative min-h-[92vh] flex flex-col justify-between overflow-hidden border-b border-white/15">
        <!-- Full-Screen Architectural Background Image -->
        <div class="absolute inset-0 z-0">
          <img
            src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1920&q=80"
            alt="Contemporary Luxury Tropical Villa with Infinity Pool at Twilight"
            class="w-full h-full object-cover object-center scale-105 transition-transform duration-1000"
            loading="eager"
          />
          <!-- Multi-layered Luxury Gradient Overlays for Razor-Sharp Legibility -->
          <div class="absolute inset-0 bg-gradient-to-r from-[#08090c]/95 via-[#08090c]/75 to-[#08090c]/45"></div>
          <div class="absolute inset-0 bg-gradient-to-t from-[#08090c] via-[#08090c]/30 to-[#08090c]/70"></div>
        </div>

        <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-8 lg:px-12 w-full flex-1 flex flex-col justify-between py-12 sm:py-16 lg:py-20">
          <!-- Top Recognition Badge -->
          <div class="flex flex-wrap items-center justify-between gap-4 pb-6 border-b border-white/15">
            <div class="inline-flex items-center gap-3 px-4 py-2 bg-[#08090c]/80 border border-[#d4a373]/40 backdrop-blur-md">
              <span class="w-2 h-2 rounded-full bg-[#d4a373]"></span>
              <span class="text-[11px] sm:text-xs font-mono-spec text-[#e6ccb2] uppercase tracking-[0.18em]">
                Specialized in 4 Distinct Architectural Typologies across Da Nang, Hoi An, and Central Coast Vietnam
              </span>
            </div>
            <div class="text-xs font-mono-spec text-white/70 uppercase tracking-[0.2em] hidden xl:block">
              TURNKEY DESIGN &amp; BUILD STUDIO // EST. 2018
            </div>
          </div>

          <!-- Center Monumental Headline -->
          <div class="my-auto py-10 sm:py-14 max-w-4xl space-y-6">
            <div class="inline-flex items-center gap-2 text-xs font-mono-spec uppercase tracking-[0.28em] text-[#d4a373]">
              <span>BESPOKE TROPICAL &amp; MODERN RESIDENTIAL STUDIO</span>
            </div>

            <h1 class="font-display text-4xl sm:text-6xl lg:text-7xl font-bold tracking-[-0.02em] uppercase leading-[1.03] text-white drop-shadow-sm">
              CONTEMPORARY RESIDENTIAL ARCHITECTURE
            </h1>

            <p class="font-serif-editorial italic text-2xl sm:text-3xl lg:text-4xl text-[#e6ccb2] font-normal leading-snug max-w-3xl">
              “Crafting bespoke coastal villas, raw tropical monoliths, and light-filled urban retreats.”
            </p>

            <p class="text-sm sm:text-base text-white/80 font-sans font-normal leading-relaxed max-w-2xl pt-1">
              We do not build generic houses. Every commission is engineered around Central Vietnam’s micro-climate—combining raw board-formed concrete, reclaimed teakwood, panoramic Low-E glass, and natural wind-tunnel courtyards.
            </p>

            <div class="pt-4 flex flex-wrap items-center gap-4">
              <a
                href="#typologies"
                class="inline-flex items-center gap-3 px-8 py-4 bg-[#d4a373] text-[#08090c] hover:bg-[#e6ccb2] text-xs font-mono-spec uppercase tracking-[0.2em] font-bold transition-all shadow-lg cursor-pointer"
              >
                <span>Explore 4 Home Styles</span>
                <span>↓</span>
              </a>
              <a
                href="#calculator"
                class="inline-flex items-center gap-3 px-7 py-4 bg-[#08090c]/80 hover:bg-white hover:text-[#08090c] text-white border border-white/30 text-xs font-mono-spec uppercase tracking-[0.2em] font-medium backdrop-blur-md transition-all cursor-pointer"
              >
                <span>Interactive Cost Calculator</span>
                <span>→</span>
              </a>
            </div>
          </div>

          <!-- Bottom Interactive 4 Quick-Jump Style Switcher Cards -->
          <div class="space-y-3 pt-6">
            <div class="flex items-center justify-between text-xs font-mono-spec uppercase tracking-[0.2em] text-white/70">
              <span>SELECT A SIGNATURE ARCHITECTURAL STYLE TO INSPECT:</span>
              <span class="hidden sm:inline text-[#d4a373]">4 DISTINCT FRAMES BELOW ↓</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
              <!-- Style 01 Quick Card -->
              <a
                href="#style-01"
                class="group relative bg-[#08090c]/85 hover:bg-[#14171f]/95 border border-white/20 hover:border-[#d4a373] p-4 backdrop-blur-md transition-all duration-300 flex flex-col justify-between cursor-pointer"
              >
                <div class="flex items-center justify-between text-[11px] font-mono-spec text-[#d4a373] mb-2">
                  <span>STYLE 01 // BRUTALISM</span>
                  <span class="group-hover:translate-x-1 transition-transform">→</span>
                </div>
                <div class="font-display text-base font-semibold text-white uppercase tracking-wide">
                  Tropical Brutalism
                </div>
                <p class="text-xs text-white/65 mt-1 line-clamp-2">
                  Raw board-formed concrete, 5m cantilevers, lush jungle &amp; infinity pools.
                </p>
              </a>

              <!-- Style 02 Quick Card -->
              <a
                href="#style-02"
                class="group relative bg-[#08090c]/85 hover:bg-[#14171f]/95 border border-white/20 hover:border-[#d4a373] p-4 backdrop-blur-md transition-all duration-300 flex flex-col justify-between cursor-pointer"
              >
                <div class="flex items-center justify-between text-[11px] font-mono-spec text-[#d4a373] mb-2">
                  <span>STYLE 02 // WABI-SABI</span>
                  <span class="group-hover:translate-x-1 transition-transform">→</span>
                </div>
                <div class="font-display text-base font-semibold text-white uppercase tracking-wide">
                  Wabi-Sabi Eco Retreat
                </div>
                <p class="text-xs text-white/65 mt-1 line-clamp-2">
                  Reclaimed teakwood, Hoa Son sandstone, lime plaster &amp; 5-star Zen serenity.
                </p>
              </a>

              <!-- Style 03 Quick Card -->
              <a
                href="#style-03"
                class="group relative bg-[#08090c]/85 hover:bg-[#14171f]/95 border border-white/20 hover:border-[#d4a373] p-4 backdrop-blur-md transition-all duration-300 flex flex-col justify-between cursor-pointer"
              >
                <div class="flex items-center justify-between text-[11px] font-mono-spec text-[#d4a373] mb-2">
                  <span>STYLE 03 // PAVILION</span>
                  <span class="group-hover:translate-x-1 transition-transform">→</span>
                </div>
                <div class="font-display text-base font-semibold text-white uppercase tracking-wide">
                  Minimalist Glass Pavilion
                </div>
                <p class="text-xs text-white/65 mt-1 line-clamp-2">
                  3.6m floor-to-ceiling Low-E glass, ultra-slim steel &amp; seamless horizon flow.
                </p>
              </a>

              <!-- Style 04 Quick Card -->
              <a
                href="#style-04"
                class="group relative bg-[#08090c]/85 hover:bg-[#14171f]/95 border border-white/20 hover:border-[#d4a373] p-4 backdrop-blur-md transition-all duration-300 flex flex-col justify-between cursor-pointer"
              >
                <div class="flex items-center justify-between text-[11px] font-mono-spec text-[#d4a373] mb-2">
                  <span>STYLE 04 // BIOPHILIC</span>
                  <span class="group-hover:translate-x-1 transition-transform">→</span>
                </div>
                <div class="font-display text-base font-semibold text-white uppercase tracking-wide">
                  Biophilic Townhouse
                </div>
                <p class="text-xs text-white/65 mt-1 line-clamp-2">
                  Triple atrium skylights, terracotta breeze walls &amp; vertical indoor gardens.
                </p>
              </a>
            </div>
          </div>
        </div>
      </section>
      <!-- =====================================================================
           4. CORE FEATURE: THE 4 ARCHITECTURAL TYPOLOGIES (4 DISTINCT SHOWCASE FRAMES)
           ===================================================================== -->
      <section id="typologies" class="py-24 sm:py-32 border-b border-white/15">
        <div class="max-w-7xl mx-auto px-4 sm:px-8 lg:px-12">
          <!-- Section Header -->
          <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-8 mb-16 pb-10 border-b border-white/15">
            <div class="space-y-4 max-w-3xl">
              <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#d4a373]/15 border border-[#d4a373]/40 text-[#d4a373] text-xs font-mono-spec uppercase tracking-[0.2em]">
                <span>SIGNATURE RESIDENTIAL PORTFOLIO // 4 DISTINCT TYPOLOGIES</span>
              </div>
              <h2 class="font-display text-3xl sm:text-5xl lg:text-6xl font-bold text-white uppercase tracking-tight leading-[1.06]">
                The 4 Architectural Typologies
              </h2>
              <p class="text-base sm:text-lg text-white/70 font-light leading-relaxed">
                Every homeowner has a distinct vision of sanctuary. Instead of vague generalizations, our studio masters four clearly defined architectural systems—each with its own structural engineering, material palette, and spatial atmosphere.
              </p>
            </div>

            <!-- Interactive Filter / Highlight Bar -->
            <div class="flex flex-wrap gap-2">
              <a href="#style-01" class="px-4 py-2.5 bg-white/5 hover:bg-[#d4a373] hover:text-[#08090c] border border-white/15 text-xs font-mono-spec uppercase tracking-wider transition-all">
                01. Brutalist
              </a>
              <a href="#style-02" class="px-4 py-2.5 bg-white/5 hover:bg-[#d4a373] hover:text-[#08090c] border border-white/15 text-xs font-mono-spec uppercase tracking-wider transition-all">
                02. Wabi-Sabi
              </a>
              <a href="#style-03" class="px-4 py-2.5 bg-white/5 hover:bg-[#d4a373] hover:text-[#08090c] border border-white/15 text-xs font-mono-spec uppercase tracking-wider transition-all">
                03. Glass Pavilion
              </a>
              <a href="#style-04" class="px-4 py-2.5 bg-white/5 hover:bg-[#d4a373] hover:text-[#08090c] border border-white/15 text-xs font-mono-spec uppercase tracking-wider transition-all">
                04. Townhouse
              </a>
            </div>
          </div>

          <!-- 4 MONUMENTAL ARCHITECTURAL FRAMES -->
          <div class="space-y-20">
            <!-- ==================== FRAME 01: TROPICAL BRUTALIST VILLA ==================== -->
            <article
              id="style-01"
              class="typology-frame scroll-mt-32 bg-[#101217] border border-white/15 hover:border-[#d4a373]/60 transition-all duration-500 overflow-hidden shadow-2xl"
            >
              <div class="grid grid-cols-1 lg:grid-cols-12">
                <!-- Large Real Photography Column (7 cols) -->
                <div class="lg:col-span-7 relative min-h-[380px] sm:min-h-[500px] overflow-hidden bg-[#08090c]">
                  <img
                    src="https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&w=1400&q=80"
                    alt="Tropical Brutalist Villa — Raw board-formed concrete, tropical plants, infinity pool"
                    class="typology-img w-full h-full object-cover object-center transition-transform duration-700"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-[#08090c]/90 via-transparent to-[#08090c]/30"></div>

                  <!-- Top Frame Badges -->
                  <div class="absolute top-5 left-5 flex flex-wrap items-center gap-2">
                    <span class="px-3.5 py-1.5 bg-[#08090c]/90 border border-[#d4a373]/50 text-[#d4a373] text-xs font-mono-spec uppercase tracking-widest backdrop-blur-md">
                      STYLE 01 // TROPICAL BRUTALISM
                    </span>
                    <span class="px-3.5 py-1.5 bg-[#08090c]/80 border border-white/20 text-white text-xs font-mono-spec uppercase tracking-widest backdrop-blur-md">
                      SON TRA PENINSULA • DA NANG
                    </span>
                  </div>

                  <!-- Bottom Image Caption Overlay -->
                  <div class="absolute bottom-5 left-5 right-5 flex flex-wrap items-end justify-between gap-4">
                    <div>
                      <span class="text-[11px] font-mono-spec text-[#e6ccb2] uppercase tracking-widest block">
                        COMPLETED SIGNATURE COMMISSION
                      </span>
                      <p class="text-sm text-white/90 font-medium">
                        Monolithic cast-in-situ concrete volumes cantilevered over cascading tropical foliage &amp; lap pool.
                      </p>
                    </div>
                    <span class="px-3 py-1 bg-white text-[#08090c] font-mono-spec text-xs font-bold uppercase">
                      450 – 1,200 M²
                    </span>
                  </div>
                </div>

                <!-- Architectural Specification Column (5 cols) -->
                <div class="lg:col-span-5 p-8 sm:p-10 lg:p-12 flex flex-col justify-between space-y-8 border-t lg:border-t-0 lg:border-l border-white/10">
                  <div class="space-y-5">
                    <div class="flex items-center justify-between text-xs font-mono-spec text-white/50 uppercase tracking-widest">
                      <span>TYPOLOGY CODE: TB-01</span>
                      <span class="text-emerald-400">● COASTAL TYPHOON RATED</span>
                    </div>

                    <h3 class="font-display text-2xl sm:text-4xl font-bold text-white uppercase tracking-tight leading-tight">
                      TROPICAL BRUTALIST VILLA
                    </h3>

                    <p class="font-serif-editorial italic text-xl text-[#e6ccb2]">
                      “Where raw architectural concrete softens under cascading jungle vines and mirror-still water.”
                    </p>

                    <p class="text-sm sm:text-base text-white/70 font-light leading-relaxed">
                      Designed for hillside and coastal plots. Unpainted board-formed concrete absorbs zero moisture during monsoon seasons while aging with a dignified natural patina alongside dense tropical landscaping and cantilevered infinity pools.
                    </p>

                    <!-- Construction & Material Specs -->
