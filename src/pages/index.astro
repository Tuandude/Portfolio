    <!-- JAVASCRIPT LOGIC -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        // 1. Mobile Menu Toggle
        const menuToggle = document.getElementById('mobile-menu-toggle');
        const mobileMenu = document.getElementById('mobile-menu');
        const iconOpen = document.getElementById('menu-icon-open');
        const iconClose = document.getElementById('menu-icon-close');
        const mobileLinks = document.querySelectorAll('.mobile-nav-link');

        if (menuToggle && mobileMenu) {
          menuToggle.addEventListener('click', () => {
            const isHidden = mobileMenu.classList.contains('hidden');
            if (isHidden) {
              mobileMenu.classList.remove('hidden');
              if (iconOpen) iconOpen.classList.add('hidden');
              if (iconClose) iconClose.classList.remove('hidden');
            } else {
              mobileMenu.classList.add('hidden');
              if (iconOpen) iconOpen.classList.remove('hidden');
              if (iconClose) iconClose.classList.add('hidden');
            }
          });

          mobileLinks.forEach((link) => {
            link.addEventListener('click', () => {
              mobileMenu.classList.add('hidden');
              if (iconOpen) iconOpen.classList.remove('hidden');
              if (iconClose) iconClose.classList.add('hidden');
            });
          });
        }

        // 2. Interactive Roast Profile
        const roastData = {
          light: {
            title: 'Light Roast (Cau Dat Typica)',
            desc: 'Discharged moments after the conclusion of the first crack. Preserving crystal-clear malic acidity, white jasmine blossoms, and sun-drenched bergamot aromatics.',
            agtron: 'AGTRON: 75 - 85 â€¢ FIRST CRACK COMPLETED',
            temp: '196Â°C - 204Â°C',
            time: '09m30s - 10m15s',
            acidityVal: 90,
            acidityText: '9.0 / 10 (Luminous & Crisp)',
            bodyVal: 45,
            bodyText: '4.5 / 10 (Silky & Tea-like)',
            sweetVal: 85,
            sweetText: '8.5 / 10 (Highland Honey)',
            flavors: [
              'ðŸŒ¸ Floral Jasmine',
              'ðŸŠ Bergamot Citrus',
              'ðŸ¯ Highland Honey',
              'ðŸ‘ Ripe Apricot',
              'ðŸŒ¿ Earl Grey Bergamot',
            ],
            methods: 'V60 Pour-Over, Chemex with bleached paper filter, Aeropress inverted. High-temperature espresso extraction not recommended.',
          },
          medium: {
            title: 'Medium Roast (Mang Den Bourbon)',
            desc: 'Roasted to City+ between first and second crack. Harmonizing refreshing stone-fruit acidity with creamy, round caramel and toasted hazelnut.',
            agtron: 'AGTRON: 55 - 65 â€¢ CRACK INTERVAL MIDPOINT',
            temp: '210Â°C - 218Â°C',
            time: '11m00s - 12m10s',
            acidityVal: 55,
            acidityText: '5.5 / 10 (Balanced & Sweet)',
            bodyVal: 75,
            bodyText: '7.5 / 10 (Round & Velvety)',
            sweetVal: 92,
            sweetText: '9.2 / 10 (Caramel & Milk Chocolate)',
            flavors: [
              'ðŸ« Creamy Milk Chocolate',
              'ðŸŒ° Toasted Hazelnut',
              'ðŸ® Salted Caramel',
              'ðŸŽ Crisp Red Apple',
              'ðŸ¯ Raw Cane Sugar',
            ],
            methods: 'Highly versatile: V60 Pour-Over, French Press, Moka Pot, or aromatic Cold Brew.',
          },
          dark: {
            title: 'Dark Roast (Dak Lak Fine Robusta)',
            desc: 'Bordering the second crack. Sugars achieve deep caramelization, yielding robust body, bittersweet chocolate, and smooth cedar smoke.',
            agtron: 'AGTRON: 35 - 45 â€¢ SECOND CRACK THRESHOLD',
            temp: '226Â°C - 232Â°C',
            time: '13m20s - 14m15s',
            acidityVal: 20,
            acidityText: '2.0 / 10 (Low Acid & Gentle)',
            bodyVal: 95,
            bodyText: '9.5 / 10 (Dense & Heavy Mouthfeel)',
            sweetVal: 70,
            sweetText: '7.0 / 10 (Bittersweet 85% Cacao)',
            flavors: [
              'ðŸ« 85% Dark Chocolate',
              'ðŸªµ Oak Barrel & Cedar',
              'â˜• Roasted Cocoa Nibs',
              'ðŸ‚ Cinnamon & Star Anise',
              'ðŸ¯ Black Molasses',
            ],
            methods: 'Traditional Vietnamese drip phin, artisan iced milk coffee, or intense tonic cold brew.',
          },
        };

        const roastTabs = document.querySelectorAll('.roast-tab-btn');
        const roastBadgeLevel = document.getElementById('roast-badge-level');
        const roastTitleDisplay = document.getElementById('roast-title-display');
        const roastDescDisplay = document.getElementById('roast-desc-display');
        const roastTempVal = document.getElementById('roast-temp-val');
        const roastTimeVal = document.getElementById('roast-time-val');
        const meterAcidityBar = document.getElementById('meter-acidity-bar');
        const meterAcidityText = document.getElementById('meter-acidity-text');
        const meterBodyBar = document.getElementById('meter-body-bar');
        const meterBodyText = document.getElementById('meter-body-text');
        const meterSweetBar = document.getElementById('meter-sweet-bar');
        const meterSweetText = document.getElementById('meter-sweet-text');
        const roastFlavorsContainer = document.getElementById('roast-flavors-container');
        const roastMethodsText = document.getElementById('roast-methods-text');

        roastTabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            const roastKey = tab.dataset.roast;
            const data = roastData[roastKey];
            if (!data) return;

            roastTabs.forEach((t) => {
              t.classList.remove('active-plate', 'border-[#A85328]');
              t.classList.add('opacity-75', 'border-[#D8D0C3]');
            });
            tab.classList.add('active-plate', 'border-[#A85328]');
            tab.classList.remove('opacity-75', 'border-[#D8D0C3]');

            if (roastBadgeLevel) roastBadgeLevel.textContent = data.agtron;
            if (roastTitleDisplay) roastTitleDisplay.textContent = data.title;
            if (roastDescDisplay) roastDescDisplay.textContent = data.desc;
            if (roastTempVal) roastTempVal.textContent = data.temp;
            if (roastTimeVal) roastTimeVal.textContent = data.time;

            if (meterAcidityBar) meterAcidityBar.style.width = data.acidityVal + '%';
            if (meterAcidityText) meterAcidityText.textContent = data.acidityText;

            if (meterBodyBar) meterBodyBar.style.width = data.bodyVal + '%';
            if (meterBodyText) meterBodyText.textContent = data.bodyText;

            if (meterSweetBar) meterSweetBar.style.width = data.sweetVal + '%';
            if (meterSweetText) meterSweetText.textContent = data.sweetText;

            if (roastMethodsText) roastMethodsText.textContent = data.methods;

            if (roastFlavorsContainer) {
              roastFlavorsContainer.innerHTML = '';
              data.flavors.forEach((flv) => {
                const chip = document.createElement('span');
                chip.className =
                  'font-serif italic text-base text-[#2B1E17] px-4 py-1.5 rounded-full bg-[#EDE8DF] border border-[#D8D0C3] transition-transform duration-200 hover:scale-105';
                chip.textContent = flv;
                roastFlavorsContainer.appendChild(chip);
              });
            }
          });
        });

        // 3. Brew Ratio Calculator
        let currentRatio = 15;
        let currentTemp = '92 - 94Â°C';
        let currentGrind = 'Medium-Fine (Granulated Sand)';
        let currentTime = '2m30s - 2m50s';
        let currentBloomRatio = 3;
        let currentMethodName = 'V60 Pour-Over';
        let currentDesc =
          'Pour gently in concentric spirals from center outwards. Avoid pouring directly against the paper filter wall. Pour in two equal pulses following the bloom phase to maximize lingering sweetness.';

        const methodBtns = document.querySelectorAll('.calc-method-btn');
        const coffeeSlider = document.getElementById('coffee-slider');
        const coffeeValDisplay = document.getElementById('coffee-val-display');
        const calcWaterVal = document.getElementById('calc-water-val');
        const calcTempVal = document.getElementById('calc-temp-val');
        const calcGrindVal = document.getElementById('calc-grind-val');
        const calcTimeVal = document.getElementById('calc-time-val');
        const calcBloomNote = document.getElementById('calc-bloom-note');
        const calcMethodDesc = document.getElementById('calc-method-desc');
        const methodSummaryBadge = document.getElementById('method-summary-badge');
        const presetBtns = document.querySelectorAll('.preset-btn');

        function updateBrewCalculation() {
          const dose = parseInt(coffeeSlider?.value, 10) || 18;
          if (coffeeValDisplay) coffeeValDisplay.textContent = dose;

          const totalWater = dose * currentRatio;
          if (calcWaterVal) calcWaterVal.textContent = totalWater;
          if (calcTempVal) calcTempVal.textContent = currentTemp;
          if (calcGrindVal) calcGrindVal.textContent = currentGrind;
          if (calcTimeVal) calcTimeVal.textContent = currentTime;
          if (methodSummaryBadge)
            methodSummaryBadge.textContent = `${currentMethodName} â€¢ Ratio 1 : ${currentRatio}`;
          if (calcMethodDesc) calcMethodDesc.textContent = currentDesc;

          if (calcBloomNote) {
            if (currentBloomRatio > 0) {
              const bloomWater = dose * currentBloomRatio;
              calcBloomNote.textContent = `BLOOM PHASE: ${bloomWater}ml WATER FOR 40 SECONDS`;
            } else {
              calcBloomNote.textContent = 'FULL IMMERSION STEEP â€¢ NO BLOOM PHASE REQUIRED';
            }
          }
        }

        methodBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            currentRatio = parseFloat(btn.dataset.ratio) || 15;
            currentTemp = btn.dataset.temp || '92 - 94Â°C';
            currentGrind = btn.dataset.grind || 'Medium';
            currentTime = btn.dataset.time || '3m00s';
            currentBloomRatio = parseFloat(btn.dataset.bloomRatio) || 2;
            currentDesc = btn.dataset.desc || '';
            currentMethodName = btn.querySelector('.font-serif.text-lg')?.textContent.trim() || 'Brew Method';

            methodBtns.forEach((b) => {
              b.classList.remove('border-[#A85328]', 'bg-[#F7F4EE]', 'shadow-xs');
              b.classList.add('border-[#D8D0C3]', 'bg-transparent', 'opacity-70');
              b.querySelector('.font-mono')?.classList.remove('text-[#A85328]');
              b.querySelector('.font-mono')?.classList.add('text-[#412F24]/70');
            });

            btn.classList.add('border-[#A85328]', 'bg-[#F7F4EE]', 'shadow-xs');
            btn.classList.remove('border-[#D8D0C3]', 'bg-transparent', 'opacity-70');
            btn.querySelector('.font-mono')?.classList.add('text-[#A85328]');
            btn.querySelector('.font-mono')?.classList.remove('text-[#412F24]/70');

            updateBrewCalculation();
          });
        });

        if (coffeeSlider) {
          coffeeSlider.addEventListener('input', updateBrewCalculation);
        }

        presetBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            const val = btn.dataset.val;
            if (coffeeSlider && val) {
              coffeeSlider.value = val;
              updateBrewCalculation();
            }
          });
        });

        updateBrewCalculation();

        // 4. Cart Toast
        let cartCount = 0;
        const cartBadge = document.getElementById('cart-badge');
        const cartBtn = document.getElementById('cart-btn');
        const addToCartBtns = document.querySelectorAll('.add-to-cart-btn');
        const toast = document.getElementById('toast-notification');
        const toastTitle = document.getElementById('toast-title');
        const toastMessage = document.getElementById('toast-message');
        let toastTimeout = null;

        function showToast(title, message) {
          if (!toast) return;
          if (toastTimeout) clearTimeout(toastTimeout);

          if (toastTitle) toastTitle.textContent = title;
          if (toastMessage) toastMessage.textContent = message;

          toast.classList.remove('translate-y-32', 'opacity-0', 'pointer-events-none');
          toast.classList.add('translate-y-0', 'opacity-100');

          toastTimeout = setTimeout(() => {
            toast.classList.remove('translate-y-0', 'opacity-100');
            toast.classList.add('translate-y-32', 'opacity-0', 'pointer-events-none');
          }, 3200);
        }

        addToCartBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            const productName = btn.dataset.name || 'Artisanal Coffee Bag';
            cartCount += 1;
            if (cartBadge) {
              cartBadge.textContent = cartCount;
            }
            showToast('Added to Coffee Bag', `${productName} (250g) has been added to your bag.`);
          });
        });

        if (cartBtn) {
          cartBtn.addEventListener('click', () => {
            if (cartCount === 0) {
              showToast('Your Coffee Bag is Empty', 'Select one of our fresh weekly roasts to taste indigenous terroir.');
            } else {
              showToast('Your Coffee Bag', `You have selected ${cartCount} bag(s) from our Da Nang atelier.`);
            }
          });
        }

        // 5. Postcard Cupping Form Submission
        const cuppingForm = document.getElementById('cupping-sample-form');
        const submitBtn = document.getElementById('submit-cupping-btn');
        const submitBtnText = document.getElementById('submit-btn-text');
        const submitSpinner = document.getElementById('submit-spinner');
        const cuppingModal = document.getElementById('cupping-modal');
        const closeModalBtn = document.getElementById('close-modal-btn');
        const modalOrderCode = document.getElementById('modal-order-code');
        const modalMessageBody = document.getElementById('modal-message-body');

        if (cuppingForm) {
          cuppingForm.addEventListener('submit', (e) => {
            e.preventDefault();

            const name = document.getElementById('sample-name')?.value || 'Friend';
            const email = document.getElementById('sample-email')?.value || '';
            const phone = document.getElementById('sample-phone')?.value || '';
            const tasteSelect = document.getElementById('sample-taste');
            const tasteText = tasteSelect ? tasteSelect.options[tasteSelect.selectedIndex]?.text : 'Curated Tasting Trio';

            if (submitBtn) submitBtn.disabled = true;
            if (submitBtnText) submitBtnText.textContent = 'Stamping Postcard...';
            if (submitSpinner) submitSpinner.classList.remove('hidden');

            setTimeout(() => {
              if (submitBtn) submitBtn.disabled = false;
              if (submitBtnText) submitBtnText.textContent = 'Stamp & Dispatch Postcard';
              if (submitSpinner) submitSpinner.classList.add('hidden');

              const randomCode = Math.floor(100 + Math.random() * 900);
              if (modalOrderCode) modalOrderCode.textContent = `#HMC-2026-${randomCode}`;

              if (modalMessageBody) {
                modalMessageBody.textContent = `Thank you, ${name}! We have recorded your selection for "${tasteText}". A 3 x 50g tasting flight will be prepared following our upcoming Tuesday roast and dispatched to your address. Confirmation dispatched to ${email} and tracking notified via ${phone}.`;
              }

              if (cuppingModal) {
                cuppingModal.classList.remove('opacity-0', 'pointer-events-none');
                cuppingModal.classList.add('opacity-100');
                const dialogCard = cuppingModal.querySelector('.bg-\\[\\#F7F4EE\\]');
                if (dialogCard) {
                  dialogCard.classList.remove('scale-95');
                  dialogCard.classList.add('scale-100');
                }
              }

              cuppingForm.reset();
            }, 800);
          });
        }

        if (closeModalBtn && cuppingModal) {
          closeModalBtn.addEventListener('click', () => {
            cuppingModal.classList.add('opacity-0', 'pointer-events-none');
            cuppingModal.classList.remove('opacity-100');
            const dialogCard = cuppingModal.querySelector('.bg-\\[\\#F7F4EE\\]');
            if (dialogCard) {
              dialogCard.classList.add('scale-95');
              dialogCard.classList.remove('scale-100');
            }
          });
        }

        // 6. Back To Top
        const backToTopBtn = document.getElementById('back-to-top-btn');
        if (backToTopBtn) {
          backToTopBtn.addEventListener('click', () => {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        }
      });
    </script>
