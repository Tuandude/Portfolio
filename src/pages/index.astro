                let y = baseY + w1 + w2 + w3;

                // Focal topographic elevation & gravity peak
                const dx = x - focal.x;
                const dy = baseY - focal.y;
                const dist = Math.hypot(dx, dy);

                if (dist < 320) {
                  const gaussian = Math.exp(-(dist * dist) / (2 * 105 * 105));
                  const elevation = -gaussian * 135 * (1 + 0.32 * Math.sin(time * 4.2 + dist * 0.04));
                  y += elevation;
                }

                // Shockwave disturbance
                for (let j = 0; j < ripples.length; j++) {
                  const rp = ripples[j];
                  const rDist = Math.hypot(x - rp.x, y - rp.y);
                  const diff = Math.abs(rDist - rp.radius);
                  if (diff < 55) {
                    y += Math.sin(diff * 0.22) * rp.strength * 22 * (1 - diff / 55);
                  }
                }

                if (firstPoint) {
                  ctx.moveTo(x, y);
                  firstPoint = false;
                } else {
                  ctx.lineTo(x, y);
                }
              }

              ctx.strokeStyle = strokeColor;
              ctx.globalAlpha = 0.55;
              ctx.lineWidth = 1.3;
              ctx.stroke();

              // Topographic peak glow near focal point
              if (Math.abs(baseY - focal.y) < 220) {
                ctx.save();
                ctx.shadowColor = glowColor;
                ctx.shadowBlur = 14;
                ctx.globalAlpha = 0.85;
                ctx.lineWidth = 1.8;
                ctx.stroke();
                ctx.restore();
              }
            }
            ctx.globalAlpha = 1.0;
          }

          // =================================================================
          // MODE 03: MATRIX VECTOR FLOW (Cybernetic Magnetic Dipole Needles)
          // =================================================================
          function renderMatrixVectorFlow() {
            const isMobile = width < 768;
            const step = isMobile ? 48 : 34;
            const cols = Math.ceil(width / step) + 1;
            const rows = Math.ceil(height / step) + 1;
            const influenceRadius = isMobile ? 260 : 360;
            const focal = getFocalPoint();

            for (let r = 0; r < rows; r++) {
              const y = r * step;
              for (let c = 0; c < cols; c++) {
                const x = c * step;

                // Base ambient fluid flow field
                let angle = Math.sin(x * 0.003 + time * 0.8) * Math.cos(y * 0.003 + time * 0.8) * Math.PI * 2;
                let needleLen = 10;
                let intensity = 0;

                // Magnetic field alignment toward focal point
                const dx = focal.x - x;
                const dy = focal.y - y;
                const dist = Math.hypot(dx, dy);

                if (dist < influenceRadius) {
                  intensity = 1 - dist / influenceRadius;
                  const angleToFocal = Math.atan2(dy, dx);
                  // Add tangent twist (magnetic curl)
                  const curl = intensity * (Math.PI * 0.35);
                  const targetAngle = angleToFocal + curl;

                  // Blend ambient with magnetic field
                  angle = targetAngle * intensity + angle * (1 - intensity);
                  needleLen = 10 + intensity * 15;
                }

                // Shockwave angular burst
                for (let i = 0; i < ripples.length; i++) {
                  const rp = ripples[i];
                  const rDist = Math.hypot(x - rp.x, y - rp.y);
                  const diff = Math.abs(rDist - rp.radius);
                  if (diff < 50) {
                    angle += (1 - diff / 50) * Math.PI * 2 * rp.strength;
                    needleLen += (1 - diff / 50) * 10;
                  }
                }

                // Needle endpoints
                const halfLen = needleLen * 0.5;
                const tailX = x - Math.cos(angle) * halfLen;
                const tailY = y - Math.sin(angle) * halfLen;
                const tipX = x + Math.cos(angle) * halfLen;
                const tipY = y + Math.sin(angle) * halfLen;

                ctx.beginPath();
                ctx.moveTo(tailX, tailY);
                ctx.lineTo(tipX, tipY);

                if (intensity > 0.15) {
                  const isHigh = intensity > 0.55;
                  ctx.strokeStyle = isHigh ? '#D4FF00' : '#00F5FF';
                  ctx.lineWidth = 1.3 + intensity * 1.2;
                  ctx.globalAlpha = 0.5 + intensity * 0.5;
                  ctx.stroke();

                  // Glowing tip
                  ctx.fillStyle = isHigh ? '#D4FF00' : '#00F5FF';
                  ctx.beginPath();
                  ctx.arc(tipX, tipY, 1.5 + intensity * 1.5, 0, Math.PI * 2);
                  ctx.fill();
                } else {
                  ctx.strokeStyle = 'rgba(148, 163, 184, 0.2)';
                  ctx.lineWidth = 0.8;
                  ctx.globalAlpha = 0.45;
                  ctx.stroke();
                }
              }
            }
            ctx.globalAlpha = 1.0;
          }

          // =================================================================
          // GLOBAL OVERLAYS: PLASMA SPOTLIGHT, AURORA TRAIL & SHOCKWAVES
          // =================================================================
          function renderOverlays() {
            const focal = getFocalPoint();
            const spotRadius = width < 768 ? 200 : 270;
            const grad = ctx.createRadialGradient(focal.x, focal.y, 0, focal.x, focal.y, spotRadius);
            grad.addColorStop(0, 'rgba(212, 255, 0, 0.20)');
            grad.addColorStop(0.35, 'rgba(0, 245, 255, 0.12)');
            grad.addColorStop(0.7, 'rgba(176, 38, 255, 0.05)');
            grad.addColorStop(1, 'rgba(5, 6, 8, 0)');

            ctx.fillStyle = grad;
            ctx.beginPath();
            ctx.arc(focal.x, focal.y, spotRadius, 0, Math.PI * 2);
            ctx.fill();

            // 2. Luminous Ribbon Aurora Trail
            if (mouseTrail.length > 2) {
              for (let i = 0; i < mouseTrail.length - 1; i++) {
                mouseTrail[i].age += 0.04;
                const p1 = mouseTrail[i];
                const p2 = mouseTrail[i + 1];
                const progress = 1 - (i / mouseTrail.length);
                if (progress <= 0) continue;

                ctx.beginPath();
                ctx.moveTo(p1.x, p1.y);
                ctx.lineTo(p2.x, p2.y);
                ctx.strokeStyle = i % 2 === 0 ? '#D4FF00' : '#00F5FF';
                ctx.globalAlpha = progress * 0.6;
                ctx.lineWidth = progress * 4.5;
                ctx.lineCap = 'round';
                ctx.stroke();
              }
              ctx.globalAlpha = 1.0;
            }

            // 3. Dimension Warp Shockwaves
            for (let i = ripples.length - 1; i >= 0; i--) {
              const r = ripples[i];
              r.radius += r.speed;
              r.alpha *= 0.945;
              r.strength *= 0.96;

              if (r.alpha > 0.02 && r.radius < r.maxRadius) {
                ctx.save();
                ctx.beginPath();
                ctx.arc(r.x, r.y, r.radius, 0, Math.PI * 2);
                ctx.strokeStyle = r.radius % 40 < 20 ? '#D4FF00' : '#00F5FF';
                ctx.lineWidth = 2.2 * (1 - r.radius / r.maxRadius);
                ctx.globalAlpha = r.alpha;
                ctx.shadowColor = '#00F5FF';
                ctx.shadowBlur = 18;
                ctx.stroke();

                // Outer echo ring
                ctx.beginPath();
                ctx.arc(r.x, r.y, Math.max(0, r.radius - 22), 0, Math.PI * 2);
                ctx.strokeStyle = '#B026FF';
                ctx.lineWidth = 1.0;
                ctx.globalAlpha = r.alpha * 0.5;
                ctx.stroke();
                ctx.restore();
              } else {
                ripples.splice(i, 1);
              }
            }
          }

          // =================================================================
          // MAIN ANIMATION LOOP (60 FPS NATIVE RAF)
          // =================================================================
          function render() {
            time += 0.016;
            ctx.clearRect(0, 0, width, height);

            // Render active mode
            if (currentMode === 'grid') {
              renderVortexGravityGrid();
            } else if (currentMode === 'topo') {
              renderNeonTopographicWaves();
            } else if (currentMode === 'vector') {
              renderMatrixVectorFlow();
            }

            // Render global overlays (Aurora Spotlight, Ribbon Trail, Shockwaves)
            renderOverlays();

            // FPS Counter
            frameCount++;
            const now = performance.now();
            if (now - lastFpsUpdate >= 1000) {
              const fps = Math.round((frameCount * 1000) / (now - lastFpsUpdate));
              frameCount = 0;
              lastFpsUpdate = now;
              if (fpsDisplay) {
                fpsDisplay.textContent = `${fps} FPS // ACTIVE`;
              }
            }

            requestAnimationFrame(render);
          }

          requestAnimationFrame(render);
        }
﻿        // ===================================================================
        // 2. MOBILE MENU & TILT CARDS
        // ===================================================================
        const menuToggle = document.getElementById('mobile-menu-toggle');
        const menuPanel = document.getElementById('mobile-menu-panel');
        const iconOpen = document.getElementById('icon-menu-open');
        const iconClose = document.getElementById('icon-menu-close');
        const mobileLinks = document.querySelectorAll('.mobile-nav-link');

        if (menuToggle && menuPanel) {
          menuToggle.addEventListener('click', () => {
            const isHidden = menuPanel.classList.contains('hidden');
            if (isHidden) {
              menuPanel.classList.remove('hidden');
              iconOpen?.classList.add('hidden');
              iconClose?.classList.remove('hidden');
            } else {
              menuPanel.classList.add('hidden');
              iconOpen?.classList.remove('hidden');
              iconClose?.classList.add('hidden');
            }
          });
          mobileLinks.forEach((link) => {
            link.addEventListener('click', () => {
              menuPanel.classList.add('hidden');
              iconOpen?.classList.remove('hidden');
              iconClose?.classList.add('hidden');
            });
          });
        }

        // 3D Tilt Cards
        const tiltCards = document.querySelectorAll('.tilt-card');
        tiltCards.forEach((card) => {
          card.addEventListener('mousemove', (e) => {
            const rect = card.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            const percentX = (x / rect.width) * 100;
            const percentY = (y / rect.height) * 100;
            const rotateX = ((y - rect.height / 2) / (rect.height / 2)) * -10;
            const rotateY = ((x - rect.width / 2) / (rect.width / 2)) * 10;

            card.style.setProperty('--mouse-x', percentX + '%');
            card.style.setProperty('--mouse-y', percentY + '%');
            card.style.transform = `perspective(1000px) rotateX(${rotateX.toFixed(1)}deg) rotateY(${rotateY.toFixed(1)}deg) scale(1.02)`;

            const coords = card.querySelector('.tilt-coords');
            if (coords) coords.textContent = `3D TILT // X: ${rotateX.toFixed(1)}° | Y: ${rotateY.toFixed(1)}°`;
          });

          card.addEventListener('mouseleave', () => {
            card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) scale(1)';
            const coords = card.querySelector('.tilt-coords');
            if (coords) coords.textContent = '3D TILT // DYNAMIC TRACKING';
          });
        });

        // Tilt Presets
        const tiltPresetBtns = document.querySelectorAll('.tilt-preset-btn');
        tiltPresetBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            const p = btn.dataset.preset;
            tiltCards.forEach((card) => {
              if (p === 'iso-left') {
                card.style.transform = 'perspective(1000px) rotateX(10deg) rotateY(-14deg) scale(1.02)';
              } else if (p === 'iso-right') {
                card.style.transform = 'perspective(1000px) rotateX(-10deg) rotateY(14deg) scale(1.02)';
              } else {
                card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) scale(1)';
              }
            });
          });
        });

        // ===================================================================
        // 3. SERVICE STACK CALCULATOR & ELECTRONIC NUMBER ROLLER
        // ===================================================================
        const tierCards = document.querySelectorAll('.tier-card');
        const energySlabs = document.querySelectorAll('.energy-slab');
        const summaryPrice = document.getElementById('summary-total-price');
        const summaryWeeks = document.getElementById('summary-total-weeks');
        const summaryDeposit = document.getElementById('summary-deposit');
        const summaryAddons = document.getElementById('summary-addon-count');
        const briefScope = document.getElementById('brief-scope');
        const briefSyncAmount = document.getElementById('brief-sync-amount');
        const briefBudgetInput = document.getElementById('brief-budget-input');
        const budgetChips = document.querySelectorAll('.budget-chip');
        const btnSyncQuote = document.getElementById('btn-sync-quote');

        let baseTier = {
          name: 'Immersive 3D Web Experience',
          price: 2800,
          weeks: 4
        };

        function recalculate() {
          let addonTotal = 0;
          let addonWeeks = 0;
          let activeCount = 0;
          let addonNames = [];

          energySlabs.forEach((slab) => {
            if (slab.getAttribute('data-active') === 'true') {
              activeCount++;
              const p = Number(slab.getAttribute('data-addon-price') || 0);
              const w = Number(slab.getAttribute('data-addon-weeks') || 0);
              const n = slab.getAttribute('data-addon-name') || '';
              addonTotal += p;
              addonWeeks += w;
              addonNames.push(n);

              const status = slab.querySelector('.slab-status');
              if (status) {
                status.textContent = 'ENGAGED';
                status.className = 'slab-status px-2.5 py-0.5 bg-[#D4FF00] text-[#050608] font-mono-tech font-black text-xs uppercase block mb-1';
              }
            } else {
              const status = slab.querySelector('.slab-status');
              if (status) {
                status.textContent = 'STANDBY';
                status.className = 'slab-status px-2.5 py-0.5 bg-white/10 text-white/60 font-mono-tech font-black text-xs uppercase block mb-1';
              }
            }
          });

          const total = baseTier.price + addonTotal;
          const weeks = baseTier.weeks + addonWeeks;
          const deposit = Math.round(total * 0.4);

          if (summaryPrice) summaryPrice.textContent = '$' + total.toLocaleString('en-US');
          if (summaryWeeks) summaryWeeks.textContent = `~ ${weeks} WEEKS`;
          if (summaryDeposit) summaryDeposit.textContent = '$' + deposit.toLocaleString('en-US');
          if (summaryAddons) summaryAddons.textContent = `${String(activeCount).padStart(2, '0')} MODULES ENGAGED`;

          const scopeStr = `Tier: ${baseTier.name} | Modules: ${addonNames.length ? addonNames.join(' + ') : 'None'} | Total: $${total.toLocaleString('en-US')} (~${weeks} weeks).`;
          if (briefScope) briefScope.value = scopeStr;
          if (briefSyncAmount) briefSyncAmount.textContent = `$${total.toLocaleString('en-US')} (~${weeks} wks)`;
        }

        tierCards.forEach((card) => {
          card.addEventListener('click', () => {
            tierCards.forEach((c) => {
              c.className = 'tier-card p-4 bg-black/25 backdrop-blur-md border border-white/15 hover:border-[#D4FF00] text-left transition-all cursor-pointer font-sans';
              c.setAttribute('aria-pressed', 'false');
            });
            card.className = 'tier-card p-4 bg-[#D4FF00] text-[#050608] border border-[#D4FF00] text-left transition-all cursor-pointer font-sans';
            card.setAttribute('aria-pressed', 'true');

            baseTier = {
              name: card.getAttribute('data-tier-name') || '',
              price: Number(card.getAttribute('data-tier-price') || 0),
              weeks: Number(card.getAttribute('data-tier-weeks') || 3)
            };
            recalculate();
          });
        });

        energySlabs.forEach((slab) => {
          slab.addEventListener('click', () => {
            const current = slab.getAttribute('data-active') === 'true';
            slab.setAttribute('data-active', String(!current));
            slab.setAttribute('aria-checked', String(!current));
            recalculate();
          });
        });

        budgetChips.forEach((chip) => {
          chip.addEventListener('click', () => {
            budgetChips.forEach((c) => c.classList.remove('is-selected'));
            chip.classList.add('is-selected');
            if (briefBudgetInput) briefBudgetInput.value = chip.dataset.budget;
          });
        });

        if (btnSyncQuote) {
          btnSyncQuote.addEventListener('click', () => {
            recalculate();
            const dispatchSec = document.getElementById('dispatch');
            dispatchSec?.scrollIntoView({ behavior: 'smooth' });
          });
        }

        recalculate();

        // Shader Core HUD Minimize / Expand Controller
        const btnToggleShader = document.getElementById('btn-toggle-shader-hud');
        const shaderBody = document.getElementById('shader-core-body');
        if (btnToggleShader && shaderBody) {
          let isShaderMinimized = false;
          btnToggleShader.addEventListener('click', () => {
            isShaderMinimized = !isShaderMinimized;
            if (isShaderMinimized) {
              shaderBody.classList.add('hidden');
              btnToggleShader.textContent = '[+ EXPAND]';
            } else {
              shaderBody.classList.remove('hidden');
              btnToggleShader.textContent = '[— MINIMIZE]';
            }
          });
        }

        // 4. Brief Form Submission
        const briefForm = document.getElementById('vortex-brief-form');
        const errorMsg = document.getElementById('brief-error-msg');
        const successPanel = document.getElementById('brief-success-panel');
        const btnReset = document.getElementById('btn-reset-brief');
        const codeDisplay = document.getElementById('confirm-brief-code');

        if (briefForm) {
          briefForm.addEventListener('submit', (e) => {
            e.preventDefault();
            const name = (document.getElementById('brief-name')?.value || '').trim();
            const email = (document.getElementById('brief-email')?.value || '').trim();

            if (!name || !email) {
              errorMsg?.classList.remove('hidden');
              return;
            }
            errorMsg?.classList.add('hidden');

            const randCode = Math.floor(1000 + Math.random() * 9000);
            if (codeDisplay) codeDisplay.textContent = `VTX-2026-${randCode}`;

            briefForm.classList.add('hidden');
            successPanel?.classList.remove('hidden');
          });
        }

        if (btnReset && briefForm && successPanel) {
          btnReset.addEventListener('click', () => {
            successPanel.classList.add('hidden');
            briefForm.classList.remove('hidden');
          });
        }

        // 5. Back to Top
        const topBtn = document.getElementById('vortex-top-btn');
        if (topBtn) {
          topBtn.addEventListener('click', () => {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        }
      });
    </script>
  </body>
</html>
