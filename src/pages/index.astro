    <!-- TOAST NOTIFICATION -->
    <div
      id="toast-notification"
      class="fixed bottom-8 right-8 z-50 max-w-sm w-full bg-[#2B1E17] text-[#EDE8DF] border border-[#A85328] p-5 shadow-2xl transition-all duration-300 transform translate-y-32 opacity-0 pointer-events-none flex items-start gap-3.5 rounded-xl"
      role="alert"
    >
      <div class="text-[#A85328] text-lg shrink-0">âœ¦</div>
      <div class="flex-1 font-serif">
        <div id="toast-title" class="font-medium text-base text-white">Added to Coffee Bag</div>
        <div id="toast-message" class="text-xs text-[#EDE8DF]/80 mt-1 italic">Single-origin fresh harvest reserved.</div>
      </div>
    </div>

    <!-- MODAL CONFIRMATION -->
    <div
      id="cupping-modal"
      class="fixed inset-0 z-50 bg-[#2B1E17]/85 backdrop-blur-sm flex items-center justify-center p-6 opacity-0 pointer-events-none transition-opacity duration-300"
      role="dialog"
      aria-modal="true"
    >
      <div class="bg-[#F7F4EE] border border-[#D8D0C3] max-w-md w-full p-10 text-center space-y-7 shadow-2xl transform scale-95 transition-transform duration-300 rounded-3xl">
        <div class="w-14 h-14 rounded-full border border-[#A85328] mx-auto flex items-center justify-center text-2xl text-[#A85328]">
          â˜•
        </div>

        <div class="space-y-3">
          <span class="font-mono text-xs uppercase text-[#A85328] tracking-widest font-bold">POSTCARD REGISTERED</span>
          <h3 class="font-serif text-3xl text-[#2B1E17] font-normal">
            Your cupping flight has been recorded!
          </h3>
          <p id="modal-message-body" class="font-serif italic text-base text-[#412F24]/85 leading-relaxed">
            Hat Moc Roastery is assembling your 3 x 50g fresh tasting pouches. Dispatch notification will be transmitted to your phone.
          </p>
        </div>

        <div class="p-4 bg-[#EDE8DF] font-mono text-xs text-[#2B1E17] border border-[#D8D0C3] rounded-xl">
          Flight Tracking ID: <strong id="modal-order-code" class="text-[#A85328]">#HMC-2026-889</strong>
        </div>

        <button
          id="close-modal-btn"
          type="button"
          class="w-full bg-[#2B1E17] hover:bg-[#A85328] text-[#F7F4EE] py-3.5 rounded-full text-xs font-mono uppercase tracking-widest transition-colors cursor-pointer font-bold"
        >
          Confirm &amp; Return to Journal
        </button>
      </div>
