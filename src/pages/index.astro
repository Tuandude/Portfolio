---
import '../styles/global.css';
// HAT MOC CRAFT ROASTERY - Specialty Coffee & Indigenous Terroir Journal
// Editorial Organic Lifestyle Edition (Kinfolk & Cereal Magazine Inspired)
// High-Resolution Curated Unsplash Coffee Editorial Photography
// Live Showcase Demo 01 for Portfolio Dang Van Bao Tuan
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>HAT MOC CRAFT ROASTERY â€” Indigenous Beans & Artisanal Slow Roasting</title>
    <meta
      name="description"
      content="Hat Moc Craft Roastery â€” Awakening the soul of indigenous beans through slow, artisanal roasting. Specialty single-origins from Cau Dat, Mang Den, and Dak Lak."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts: Cormorant Garamond, Playfair Display, Plus Jakarta Sans & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,600&family=JetBrains+Mono:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />

    <style>
      :root {
        --paper-base: #f7f4ee;
        --paper-warm: #ede8df;
        --paper-tint: #fbf9f4;
        --paper-dark: #e4ddd2;
        --coffee-black: #2b1e17;
        --coffee-brown: #412f24;
        --terracotta: #a85328;
        --terracotta-light: #c86432;
        --sage-green: #5a6b54;
        --sage-light: #73846d;
        --amber-glow: #c59b6d;

        --font-serif: 'Cormorant Garamond', 'Playfair Display', Georgia, serif;
        --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
        --font-mono: 'JetBrains Mono', monospace;
      }

      body {
        background-color: var(--paper-base);
        color: var(--coffee-black);
        font-family: var(--font-sans);
        margin: 0;
        padding: 0;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
      }

      .font-serif { font-family: var(--font-serif); }
      .font-mono { font-family: var(--font-mono); }

      /* Editorial Drop Cap with Generous Breathing Room */
      .drop-cap::first-letter {
        font-family: var(--font-serif);
        font-size: 5.5rem;
        line-height: 0.8;
        float: left;
        margin-right: 1.35rem;
        margin-top: 0.35rem;
        margin-bottom: 0.25rem;
        color: var(--terracotta);
        font-style: italic;
        font-weight: 500;
      }

      .paper-grain {
        background-color: var(--paper-base);
        background-image:
          radial-gradient(rgba(43, 30, 23, 0.035) 1px, transparent 1px),
          radial-gradient(rgba(168, 83, 40, 0.02) 1px, transparent 1px);
        background-size: 28px 28px, 36px 36px;
        background-position: 0 0, 14px 14px;
      }

      .kraft-paper {
        background-color: #f0eae1;
        background-image:
          radial-gradient(#dcd4c7 0.75px, transparent 0.75px),
          linear-gradient(to right, rgba(65, 47, 36, 0.03) 1px, transparent 1px);
        background-size: 22px 22px, 100% 32px;
      }

      .film-texture {
        background-image: radial-gradient(rgba(65, 47, 36, 0.045) 1px, transparent 0);
        background-size: 8px 8px;
      }

      input[type='range'] {
        -webkit-appearance: none;
        appearance: none;
        background: rgba(65, 47, 36, 0.16);
        height: 2px;
        border-radius: 1px;
        outline: none;
      }

      input[type='range']::-webkit-slider-thumb {
        -webkit-appearance: none;
        appearance: none;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: var(--terracotta);
        border: 2px solid var(--paper-base);
        box-shadow: 0 3px 10px rgba(43, 30, 23, 0.25);
        cursor: grab;
        transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.2s ease;
      }

      input[type='range']::-webkit-slider-thumb:active {
        cursor: grabbing;
        transform: scale(1.22);
        background: var(--coffee-black);
      }

      .postcard-input {
        background: transparent;
        border: none;
        border-bottom: 1px dashed rgba(65, 47, 36, 0.35);
        border-radius: 0;
        padding: 12px 0;
        color: var(--coffee-black);
        font-family: var(--font-serif);
        font-size: 1.2rem;
        outline: none;
        transition: border-color 0.25s ease;
      }

      .postcard-input:focus {
        border-bottom: 1.5px solid var(--terracotta);
      }

      .postcard-input::placeholder {
        color: rgba(65, 47, 36, 0.38);
        font-style: italic;
        font-family: var(--font-serif);
      }

      .ceramic-plate {
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        cursor: pointer;
      }
      .ceramic-plate:hover {
        transform: translateY(-6px);
      }
      .ceramic-plate.active-plate {
        box-shadow: 0 18px 40px -10px rgba(43, 30, 23, 0.22);
        border-color: var(--terracotta);
      }

      .stagger-card {
        transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.45s ease;
      }
      .stagger-card:hover {
        transform: translateY(-8px);
      }

      .editorial-img-zoom {
        transition: transform 0.85s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .editorial-frame:hover .editorial-img-zoom {
        transform: scale(1.05);
      }
    </style>
  </head>
  <body class="paper-grain antialiased min-h-screen flex flex-col selection:bg-[#A85328] selection:text-[#F7F4EE]">
    <!-- 1. TOP NOTIFICATION BAR -->
    <aside
      class="w-full bg-[#2B1E17] text-[#EDE8DF] px-6 sm:px-12 py-3.5 border-b border-[#412F24]/50 z-50 text-[12px] tracking-widest font-sans sticky top-0"
      aria-label="Portfolio Navigation"
    >
      <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2.5">
        <a
          href="/#projects"
          class="inline-flex items-center gap-3 text-[#EDE8DF]/90 hover:text-white transition-colors group"
        >
          <span class="inline-block transition-transform group-hover:-translate-x-1.5 text-[#A85328] font-bold">â†</span>
          <span class="font-medium tracking-wide">Back to Portfolio â€” Dang Van Bao Tuan</span>
          <span class="text-[#EDE8DF]/30 hidden sm:inline">â€¢</span>
          <span class="text-[#EDE8DF]/70 text-[11px] hidden sm:inline italic font-serif">Live Showcase 01</span>
        </a>

        <div class="flex items-center gap-5 text-[11px] text-[#EDE8DF]/75 font-mono">
          <span class="inline-flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-[#A85328] animate-pulse"></span>
            Specialty Coffee Monograph â€¢ Vol. 04
          </span>
          <span class="hidden md:inline text-[#EDE8DF]/45">Da Nang, 16Â°04'N 108Â°13'E</span>
        </div>
      </div>
    </aside>

    <!-- 2. EDITORIAL MASTHEAD & NAVIGATION -->
    <header class="w-full border-b border-[#412F24]/10 bg-[#F7F4EE]/95 backdrop-blur-md sticky top-[45px] z-40">
      <div class="max-w-7xl mx-auto px-6 sm:px-12 lg:px-16 py-7 sm:py-9 flex items-center justify-between">
        <a href="#hero" class="text-left group inline-block space-y-1">
          <span class="font-mono text-[10px] sm:text-[11px] tracking-[0.32em] text-[#5A6B54] uppercase block font-semibold">
            ARTISANAL CRAFT ROASTERY
          </span>
          <span class="font-serif text-2xl sm:text-3xl lg:text-[38px] font-medium tracking-[0.02em] text-[#2B1E17] group-hover:text-[#A85328] transition-colors leading-none block">
            HAT MOC CRAFT ROASTERY
          </span>
        </a>

        <nav class="hidden lg:flex items-center gap-10 text-[12px] tracking-[0.18em] text-[#412F24]/85 uppercase font-sans font-medium" aria-label="Editorial Navigation">
          <a href="#philosophy" class="hover:text-[#A85328] transition-colors py-1">Origin &amp; Farming</a>
          <a href="#roast-matrix" class="hover:text-[#A85328] transition-colors py-1">Roasting Craft</a>
          <a href="#brew-calculator" class="hover:text-[#A85328] transition-colors py-1">Field Notebook</a>
          <a href="#curated-harvests" class="hover:text-[#A85328] transition-colors py-1">Bean Reserve</a>
          <a href="#riverside-story" class="hover:text-[#A85328] transition-colors py-1">River Atelier</a>
          <a href="#cupping-postcard" class="hover:text-[#A85328] transition-colors py-1">Cupping Flight</a>
        </nav>

        <div class="flex items-center gap-5">
          <button
            id="cart-btn"
            type="button"
            class="flex items-center gap-3 text-xs font-mono text-[#2B1E17] hover:text-[#A85328] transition-colors cursor-pointer py-2.5 px-5 rounded-full border border-[#D8D0C3] bg-[#FAF7F2] hover:bg-[#EDE8DF]"
            aria-label="Tasting Bag"
          >
            <span class="text-sm">ðŸ‘œ</span>
            <span class="hidden sm:inline text-[#412F24]/80">Tasting Bag:</span>
            <span id="cart-badge" class="font-mono font-bold text-[#A85328]">0</span>
          </button>

          <button
            id="mobile-menu-toggle"
            type="button"
            class="lg:hidden p-2.5 text-[#2B1E17] hover:text-[#A85328] transition-colors"
            aria-label="Open Mobile Menu"
          >
            <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <line x1="3" y1="7" x2="21" y2="7"></line>
              <line x1="7" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="17" x2="21" y2="17"></line>
            </svg>
            <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
      </div>

      <div id="mobile-menu" class="hidden lg:hidden border-t border-[#412F24]/10 bg-[#F7F4EE] px-8 py-8 space-y-5 text-sm font-sans tracking-widest uppercase text-[#412F24]">
        <a href="#philosophy" class="mobile-nav-link block hover:text-[#A85328]">Origin &amp; Farming</a>
        <a href="#roast-matrix" class="mobile-nav-link block hover:text-[#A85328]">Roasting Craft (SCA)</a>
        <a href="#brew-calculator" class="mobile-nav-link block hover:text-[#A85328]">Field Notebook &amp; Brew Ratio</a>
        <a href="#curated-harvests" class="mobile-nav-link block hover:text-[#A85328]">Curated Bean Reserve</a>
        <a href="#riverside-story" class="mobile-nav-link block hover:text-[#A85328]">Han River Atelier</a>
        <a href="#cupping-postcard" class="mobile-nav-link block hover:text-[#A85328]">Request Tasting Flight</a>
      </div>
    </header>

    <main class="flex-1">
      <!-- ============================================================== -->
      <!-- SECTION 1: HERO (KINFOLK EDITORIAL - MORNING LIGHT STILL LIFE) -->
      <!-- ============================================================== -->
      <section
        id="hero"
        class="relative py-28 sm:py-36 lg:py-44 overflow-hidden border-b border-[#412F24]/15 bg-[#F7F4EE] bg-cover bg-center"
        style="background-image: url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1920&q=80');"
      >
        <!-- Full-bleed background image with soft warm editorial gradient overlay -->
        <div class="absolute inset-0 z-0">
          <img
            src="https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1920&q=80"
            alt="Artisanal pour-over coffee table in serene morning dawn light"
            class="w-full h-full object-cover object-center filter saturate-[0.95] contrast-[0.98]"
            loading="eager"
            decoding="async"
          />
          <div class="absolute inset-0 backdrop-blur-[1px] bg-gradient-to-r from-[#F7F4EE]/92 via-[#F7F4EE]/85 to-[#F7F4EE]/70"></div>
          <div class="absolute inset-0 bg-gradient-to-t from-[#F7F4EE]/85 via-transparent to-[#F7F4EE]/35"></div>
          <div class="absolute inset-0 film-texture opacity-25 pointer-events-none"></div>
        </div>

        <div class="relative z-10 max-w-7xl mx-auto px-6 sm:px-12 lg:px-16">
          <div class="flex items-center justify-between border-b border-[#412F24]/15 pb-6 mb-16 sm:mb-20 font-mono text-[11px] text-[#412F24]/75 uppercase tracking-[0.26em]">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[#A85328]"></span>
              <span>Issue No. 04 â€¢ Highland Harvest Edition</span>
            </div>
            <div class="hidden sm:block">Da Nang â€” Artisanal Drum Roastery</div>
            <div>Folio 01 / 06</div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-12 gap-14 lg:gap-20 items-center">
            <div class="lg:col-span-7 space-y-10 text-left">
              <div class="inline-block">
                <span class="text-xs font-mono uppercase tracking-[0.3em] text-[#A85328] font-semibold">
                  CHRONICLES OF NATIVE TERROIR
                </span>
                <div class="w-16 h-px bg-[#A85328] mt-3"></div>
              </div>

              <h1 class="font-serif text-5xl sm:text-6xl lg:text-[72px] text-[#2B1E17] font-normal leading-[1.12] tracking-tight">
                Awakening the <em class="italic font-light text-[#A85328]">soul of indigenous beans</em> through slow, artisanal roasting.
              </h1>

              <p class="text-xl sm:text-2xl text-[#412F24]/85 font-serif leading-relaxed max-w-2xl italic">
                From the mist-shrouded volcanic slopes of Cau Dat and Mang Den to our tranquil brick roastery overlooking the Han River. We honor one quiet discipline: letting every harvest express its purest origin.
              </p>

              <div class="pt-10 border-t border-[#412F24]/15 grid grid-cols-1 sm:grid-cols-3 gap-8 font-sans">
                <div class="space-y-3">
                  <div class="font-mono text-xs text-[#A85328] uppercase tracking-wider font-semibold">Cau Dat â€” 1,650m</div>
                  <p class="text-sm text-[#412F24]/80 leading-relaxed font-serif text-[16px]">
                    High-altitude microclimate cultivating natural cherry sugars exceeding 21Â° Brix and luminous malic acidity.
                  </p>
                </div>

                <div class="space-y-3">
                  <div class="font-mono text-xs text-[#5A6B54] uppercase tracking-wider font-semibold">5kg Cast-Iron Drum</div>
                  <p class="text-sm text-[#412F24]/80 leading-relaxed font-serif text-[16px]">
                    Gentle conductive heat transfer allowing our master roaster to listen intimately to the first crack.
                  </p>
                </div>

                <div class="space-y-3">
                  <div class="font-mono text-xs text-[#2B1E17] uppercase tracking-wider font-semibold">72h Anaerobic Process</div>
                  <p class="text-sm text-[#412F24]/80 leading-relaxed font-serif text-[16px]">
                    Slow whole-cherry fermentation unlocking delicate floral jasmine, bergamot, and wild highland honey.
                  </p>
                </div>
              </div>

              <div class="mt-12 pt-4 flex flex-wrap items-center gap-7 text-sm">
                <a
                  href="#roast-matrix"
                  class="inline-flex items-center gap-4 bg-[#2B1E17] text-[#F7F4EE] hover:bg-[#A85328] px-9 py-4 rounded-full font-mono text-xs uppercase tracking-[0.2em] transition-all shadow-sm"
                >
                  <span>Explore SCA Cupping Notes</span>
                  <span>â†’</span>
                </a>

                <a
                  href="#brew-calculator"
                  class="inline-flex items-center gap-4 text-[#412F24] hover:text-[#A85328] font-mono text-xs uppercase tracking-[0.2em] py-4 px-2 group"
                >
                  <span class="w-10 h-px bg-[#412F24]/50 group-hover:w-14 group-hover:bg-[#A85328] transition-all"></span>
                  <span>Brew Ratio Calculator</span>
                </a>
              </div>
            </div>

            <!-- Right Column: Kinfolk Curated Framed Still-life Artwork -->
            <div class="lg:col-span-5 relative mt-6 lg:mt-0">
              <div class="editorial-frame relative bg-[#FAF7F2] p-5 sm:p-7 rounded-3xl shadow-2xl border border-[#D8D0C3]/80 transition-transform duration-500 hover:-translate-y-1">
                <div class="absolute -top-4 -right-4 bg-[#2B1E17] text-[#F7F4EE] px-4 py-1.5 rounded-full font-mono text-[10px] tracking-widest uppercase border border-[#EDE8DF]/30 shadow-md hidden sm:block">
                  Micro-Lot #402 â€¢ Anaerobic
                </div>

                <div class="relative w-full aspect-[4/5] overflow-hidden rounded-2xl bg-[#EDE8DF]">
                  <img
                    src="https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1000&q=80"
                    alt="Morning coffee table still life bathed in golden dawn light"
                    class="editorial-img-zoom w-full h-full object-cover object-center"
                    loading="eager"
                    decoding="async"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-[#2B1E17]/45 via-transparent to-transparent"></div>
                  <div class="absolute bottom-4 left-4 right-4 flex justify-between items-end text-white font-mono text-[11px]">
                    <span class="tracking-widest uppercase">Da Nang Roastery</span>
                    <span class="opacity-85">Batch #402 Typica</span>
                  </div>
                </div>

                <div class="mt-5 pt-4 border-t border-[#412F24]/10 flex justify-between items-center text-left">
                  <span class="font-serif italic text-base text-[#412F24]/80">
                    Fig. 01 â€” Morning still-life extraction on aged camphor wood
                  </span>
                  <span class="font-mono text-[10px] text-[#A85328] uppercase tracking-wider font-bold">
                    16Â°04'N
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
      <!-- ============================================================== -->
      <!-- SECTION 2: THE ORIGIN & FARMING (MISTY HIGHLAND PLANTATION)   -->
      <!-- ============================================================== -->
      <section
        id="philosophy"
        class="relative py-28 sm:py-36 lg:py-44 border-b border-[#412F24]/15 overflow-hidden bg-[#F7F4EE] bg-cover bg-center"
        style="background-image: url('https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=1920&q=80');"
      >
        <!-- Full-Bleed Background: Cau Dat Highland Misty Plantation -->
        <div class="absolute inset-0 z-0">
          <img
            src="https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=1920&q=80"
            alt="Highland misty coffee plantation and evergreen slopes"
            class="w-full h-full object-cover object-center filter saturate-[0.9] contrast-[0.98]"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute inset-0 backdrop-blur-[1px] bg-gradient-to-r from-[#F7F4EE]/92 via-[#F7F4EE]/86 to-[#F7F4EE]/78"></div>
          <div class="absolute inset-0 bg-gradient-to-b from-[#F7F4EE]/80 via-transparent to-[#F7F4EE]/85"></div>
          <div class="absolute inset-0 film-texture opacity-25 pointer-events-none"></div>
        </div>

        <div class="relative z-10 max-w-6xl mx-auto px-6 sm:px-12">
          <div class="space-y-4 mb-20 text-center max-w-3xl mx-auto">
            <span class="text-xs font-mono tracking-[0.3em] text-[#5A6B54] uppercase font-bold">
              THE ORIGIN &amp; INDIGENOUS TERROIR
            </span>
            <h2 class="font-serif text-4xl sm:text-6xl text-[#2B1E17] font-normal tracking-tight">
              To let the bean speak its unvarnished truth.
            </h2>
            <div class="w-12 h-px bg-[#A85328] mx-auto mt-6"></div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-start">
            <!-- Left essay text -->
            <div class="lg:col-span-7 space-y-10 text-[#412F24] font-serif text-xl sm:text-[22px] leading-[1.85] text-justify">
              <p class="drop-cap">
                Perhaps the most courageous discipline for a master roaster is not to manufacture theatrical aromas or saturate beans with artificial gloss, but to pause at the precise threshold of perfection. To withdraw the flame when the gentle citric notesâ€”reminiscent of fresh highland bergamotâ€”have just awakened; to release the batch when natural caramel sweetness crystallizes from the indigenous sugars of cherries ripened beneath Highland fog.
              </p>

              <blockquote class="my-14 py-8 px-6 border-l-2 border-[#A85328] bg-[#EDE8DF]/40 rounded-r-2xl font-serif italic text-2xl sm:text-3xl text-[#A85328] leading-relaxed">
                "We do not manufacture flavor. The soil, the altitude, and the morning highland mist created it nine months before the cherries ever reached our roastery door."
              </blockquote>

              <p>
                At Hat Moc Roastery, our 5kg cast-iron drum represents an inviolable standard. In such modest batches, the first crack resonates crisply, like dry timber snapping on a winter hearth. The roaster detects the aromatic inflection from toasted bread crust to wild mountain blossom honey within six fleeting seconds. It is a moment of unbroken stillness and reverence, untouched by mass industrial algorithms.
              </p>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-10 pt-8 text-sm font-sans text-[#412F24]/80">
                <div class="space-y-3 bg-[#F7F4EE] p-6 rounded-2xl border border-[#D8D0C3]/80">
                  <span class="font-mono text-xs text-[#A85328] uppercase tracking-widest block font-bold">01 / DIRECT TRADE SOURCING</span>
                  <p class="font-serif text-base text-[#412F24] leading-relaxed">
                    Procuring directly from indigenous smallholders in Tram Hanh and Mang Den at 40% above fair-market rates, honoring the families who hand-pick each cherry at peak ripeness.
                  </p>
                </div>

                <div class="space-y-3 bg-[#F7F4EE] p-6 rounded-2xl border border-[#D8D0C3]/80">
                  <span class="font-mono text-xs text-[#5A6B54] uppercase tracking-widest block font-bold">02 / NATURAL FIBER PACKAGING</span>
                  <p class="font-serif text-base text-[#412F24] leading-relaxed">
                    Unbleached Kraft bags without aluminum heavy-metal foils, fitted with a one-way degassing valve to let the beans breathe naturally and protect volatile aromatic esters.
                  </p>
                </div>
              </div>
            </div>

            <!-- Right: Editorial Diptych (Two high-res documentary photos) -->
            <div class="lg:col-span-5 space-y-10">
              <!-- Plate 01: Cherries on branch -->
              <div class="editorial-frame bg-[#FAF7F2] p-4 sm:p-5 rounded-2xl border border-[#D8D0C3] shadow-lg">
