---
import '../styles/global.css';
// VORTEX DIGITAL LAB - High-Velocity Creative Engineering & 3D WebGL Studio
// Broken-Grid Kinetic Edition (Awwwards & FWA Inspired)
// Live Showcase Demo 03 for Portfolio Dang Van Bao Tuan
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>VORTEX DIGITAL LAB — High-Velocity Creative Engineering & 3D WebGL</title>
    <meta
      name="description"
      content="Vortex Digital Lab — Redefining the digital frontier through high-velocity creative engineering. Real-time 3D WebGL experiences, algorithmic branding, and spatial web systems."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts: Space Grotesk, Syne, Plus Jakarta Sans & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,700;0,800;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&family=Syne:wght@700;800&display=swap"
      rel="stylesheet"
    />

    <style>
      :root {
        --bg-void: #050608;
        --bg-deep: #090B10;
        --acid-lime: #D4FF00;
        --cyber-purple: #B026FF;
        --plasma-cyan: #00F5FF;
        --text-pure: #FFFFFF;
        --text-dim: #94A3B8;

        --font-display: 'Space Grotesk', 'Plus Jakarta Sans', sans-serif;
        --font-syne: 'Syne', 'Space Grotesk', sans-serif;
        --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
        --font-mono: 'JetBrains Mono', monospace;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html,
      body {
        background-color: var(--bg-void);
        color: var(--text-pure);
        font-family: var(--font-sans);
        margin: 0;
        padding: 0;
        overflow-x: hidden;
        max-width: 100vw;
      }

      .font-display { font-family: var(--font-display); }
      .font-syne { font-family: var(--font-syne); }
      .font-mono-tech { font-family: var(--font-mono); }

      /* Neon text strokes & glows */
      .stroke-acid {
        -webkit-text-stroke: 2px #D4FF00;
        color: transparent;
      }

      .stroke-white {
        -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.6);
        color: transparent;
      }

      .stroke-cyan {
        -webkit-text-stroke: 1.5px #00F5FF;
        color: transparent;
      }

      .acid-glow-text { text-shadow: 0 0 28px rgba(212, 255, 0, 0.45); }
      .cyan-glow-text { text-shadow: 0 0 28px rgba(0, 245, 255, 0.45); }
      .purple-glow-text { text-shadow: 0 0 28px rgba(176, 38, 255, 0.5); }

      /* Kinetic Dual Marquee */
      @keyframes marqueeLeft {
        0% { transform: translate3d(0%, 0, 0); }
        100% { transform: translate3d(-50%, 0, 0); }
      }

      @keyframes marqueeRight {
        0% { transform: translate3d(-50%, 0, 0); }
        100% { transform: translate3d(0%, 0, 0); }
      }

      .marquee-track-left {
        display: flex;
        width: max-content;
        animation: marqueeLeft 22s linear infinite;
      }

      .marquee-track-right {
        display: flex;
        width: max-content;
        animation: marqueeRight 24s linear infinite;
      }

      .marquee-track-left:hover,
      .marquee-track-right:hover {
        animation-play-state: paused;
      }

      /* 3D Perspective Tilt Cards */
      .tilt-card {
        transform-style: preserve-3d;
        transition: transform 0.16s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.3s ease;
        will-change: transform;
        position: relative;
      }

      .tilt-card.is-resetting {
        transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.4s ease;
      }

      .tilt-card-glow {
        position: absolute;
        inset: 0;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.25s ease;
        background: radial-gradient(
          500px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
          rgba(212, 255, 0, 0.28),
          rgba(0, 245, 255, 0.1) 40%,
          transparent 70%
        );
        mix-blend-mode: screen;
        z-index: 20;
      }

      .tilt-card:hover .tilt-card-glow { opacity: 1; }

      /* Energy Slabs */
      .energy-slab {
        position: relative;
        transition: all 0.28s cubic-bezier(0.16, 1, 0.3, 1);
        clip-path: polygon(0 0, calc(100% - 18px) 0, 100% 18px, 100% 100%, 18px 100%, 0 calc(100% - 18px));
      }

      .energy-slab[data-active='true'] {
        background: linear-gradient(90deg, rgba(212, 255, 0, 0.22) 0%, rgba(0, 245, 255, 0.10) 65%, rgba(0, 0, 0, 0.45) 100%);
        backdrop-filter: blur(12px);
        box-shadow: -6px 0 0 #D4FF00, 0 12px 40px -12px rgba(212, 255, 0, 0.35);
        transform: translateX(8px);
      }

      .energy-slab[data-active='false'] {
        background: rgba(0, 0, 0, 0.35);
        backdrop-filter: blur(12px);
        box-shadow: -3px 0 0 rgba(148, 163, 184, 0.25);
      }

      .energy-slab:hover { transform: translateX(10px); }

      .budget-chip {
        clip-path: polygon(10px 0, 100% 0, calc(100% - 10px) 100%, 0 100%);
        transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .budget-chip.is-selected {
        background: #D4FF00;
        color: #050608;
        box-shadow: 0 0 28px rgba(212, 255, 0, 0.7), 4px 4px 0px #B026FF;
        transform: translateY(-2px);
      }
    </style>
  </head>
  <body class="antialiased min-h-screen flex flex-col selection:bg-[#D4FF00] selection:text-[#050608] relative">
    <!-- 0. HIGH-END 60FPS INTERACTIVE HTML5 CANVAS BACKGROUND -->
    <canvas id="vortex-canvas" class="fixed inset-0 w-full h-full pointer-events-none z-0"></canvas>

    <!-- 1. TOP PORTFOLIO RETURN STRIP -->
    <aside
      class="sticky top-0 z-50 w-full bg-[#050608]/90 text-white border-b border-[#D4FF00]/40 backdrop-blur-xl px-4 sm:px-8 py-3"
      aria-label="Return Navigation"
    >
      <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2.5 text-xs">
        <a
          href="/#projects"
          class="inline-flex items-center gap-2.5 text-white hover:text-[#D4FF00] font-semibold transition-colors group"
        >
          <span class="inline-flex items-center justify-center px-2 py-0.5 bg-[#D4FF00] text-[#050608] font-mono-tech font-extrabold text-xs transition-transform group-hover:-translate-x-1">
            ←
          </span>
          <span class="tracking-tight">Back to Portfolio — Dang Van Bao Tuan</span>
          <span class="text-white/30 hidden sm:inline">•</span>
          <span class="text-white/60 text-[11px] hidden sm:inline font-mono-tech">Live Showcase 03</span>
        </a>

        <!-- Interactive Background Mode Switcher HUD -->
        <div class="flex flex-wrap items-center gap-2 sm:gap-3">
          <span class="text-[10px] font-mono-tech text-white/50 uppercase tracking-widest hidden lg:inline">// CANVAS FX:</span>
          <div class="flex items-center gap-1 bg-[#090B10] p-1 border border-white/10" id="hud-mode-container" role="tablist" aria-label="Interactive Canvas Background Modes">
            <button
              type="button"
              class="canvas-mode-btn is-active px-2.5 py-1 text-[10px] font-mono-tech uppercase tracking-wider transition-all cursor-pointer font-bold bg-[#D4FF00] text-[#050608] shadow-[0_0_12px_rgba(212,255,0,0.5)]"
              data-mode="grid"
              title="Mode 01: Spacetime Vortex Gravity Grid"
            >
              <span class="inline-block mr-1">01</span>VORTEX GRID
            </button>
            <button
              type="button"
              class="canvas-mode-btn px-2.5 py-1 text-[10px] font-mono-tech uppercase tracking-wider transition-all cursor-pointer text-white/70 hover:text-white hover:bg-white/10 font-medium"
              data-mode="topo"
              title="Mode 02: Neon 3D Topographic Waves"
            >
              <span class="inline-block mr-1">02</span>TOPO WAVES
            </button>
            <button
              type="button"
              class="canvas-mode-btn px-2.5 py-1 text-[10px] font-mono-tech uppercase tracking-wider transition-all cursor-pointer text-white/70 hover:text-white hover:bg-white/10 font-medium"
              data-mode="vector"
              title="Mode 03: Matrix Vector Compass Field"
            >
              <span class="inline-block mr-1">03</span>VECTOR FLOW
            </button>
          </div>
          <span class="inline-flex items-center gap-1.5 bg-[#D4FF00]/10 px-2.5 py-1 text-[10px] font-mono-tech text-[#D4FF00] border-l-2 border-[#D4FF00] hidden sm:inline-flex">
            <span class="w-1.5 h-1.5 bg-[#D4FF00] animate-ping rounded-full"></span>
            <span id="canvas-fps-display">60 FPS // ACTIVE</span>
          </span>
        </div>
      </div>
    </aside>

    <!-- 2. HIGH-VELOCITY FLOATING NAVIGATION -->
    <header class="sticky top-[49px] z-40 w-full px-4 sm:px-8 pt-3 pointer-events-none">
      <div class="max-w-7xl mx-auto flex items-center justify-between gap-4 pointer-events-auto bg-[#050608]/85 backdrop-blur-2xl px-5 sm:px-8 py-3.5 border-b-2 border-[#D4FF00]/70 shadow-[0_10px_40px_rgba(0,0,0,0.85)]">
        <a href="#hero" class="flex items-center gap-3.5 group shrink-0">
          <div class="w-10 h-10 bg-[#D4FF00] text-[#050608] flex items-center justify-center font-mono-tech font-black text-base -rotate-3 group-hover:rotate-0 transition-transform shadow-[3px_3px_0px_#B026FF]">
            VX
          </div>
          <div>
            <div class="font-display font-extrabold text-sm sm:text-base tracking-wider text-white group-hover:text-[#D4FF00] transition-colors">
              VORTEX<span class="text-[#D4FF00]">.LAB</span>
            </div>
            <div class="text-[10px] font-mono-tech tracking-widest text-[#00F5FF] uppercase">
              CREATIVE ENGINEERING STUDIO
            </div>
          </div>
        </a>

        <nav class="hidden lg:flex items-center gap-8 font-mono-tech text-xs uppercase tracking-widest" aria-label="Main Navigation">
          <a href="#capabilities" class="text-white/80 hover:text-[#D4FF00] transition-colors">/ Capabilities</a>
          <a href="#works" class="text-white/80 hover:text-[#00F5FF] transition-colors">/ 3D Works</a>
          <a href="#pricing" class="text-white/80 hover:text-[#D4FF00] transition-colors">/ Service Stack</a>
          <a href="#pipeline" class="text-white/80 hover:text-[#B026FF] transition-colors">/ Vortex Engine</a>
          <a href="#dispatch" class="text-white/80 hover:text-[#D4FF00] transition-colors">/ Signal Brief</a>
        </nav>

        <div class="hidden sm:flex items-center">
          <a
            href="#dispatch"
            class="inline-flex items-center gap-2 px-5 py-2.5 bg-[#D4FF00] text-[#050608] font-mono-tech font-extrabold text-xs uppercase tracking-wider hover:bg-[#00F5FF] transition-all shadow-[4px_4px_0px_#B026FF]"
          >
            <span>Dispatch Signal</span>
            <span>↗</span>
          </a>
        </div>

        <button
          id="mobile-menu-toggle"
          type="button"
          class="lg:hidden inline-flex items-center justify-center w-10 h-10 bg-[#D4FF00] text-[#050608] font-mono-tech font-bold"
          aria-label="Toggle Navigation"
        >
          <svg id="icon-menu-open" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="square" d="M4 7h16M4 12h16M4 17h10" />
          </svg>
          <svg id="icon-menu-close" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="square" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div
        id="mobile-menu-panel"
        class="hidden lg:hidden pointer-events-auto max-w-7xl mx-auto bg-[#050608]/95 backdrop-blur-2xl border-b-2 border-[#D4FF00] px-6 py-6 space-y-4"
      >
        <div class="flex flex-col gap-3 font-display font-extrabold text-lg uppercase">
          <a href="#capabilities" class="mobile-nav-link text-white hover:text-[#D4FF00]">/ Capabilities</a>
          <a href="#works" class="mobile-nav-link text-white hover:text-[#00F5FF]">/ 3D Spatial Works</a>
          <a href="#pricing" class="mobile-nav-link text-white hover:text-[#D4FF00]">/ Service Energy Stack</a>
          <a href="#pipeline" class="mobile-nav-link text-white hover:text-[#B026FF]">/ Vortex Engine Flow</a>
          <a href="#dispatch" class="mobile-nav-link text-white hover:text-[#D4FF00]">/ Digital Signal Dispatcher</a>
        </div>
      </div>
    </header>
﻿    <main class="flex-1 overflow-x-hidden relative z-10">
      <!-- 3. HERO SECTION: BROKEN GRID & KINETIC TYPOGRAPHY -->
      <section id="hero" class="relative pt-14 pb-24 lg:pt-24 lg:pb-36 overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-8 relative z-10">
          <!-- Floating Telemetry Strip -->
          <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
            <div class="inline-flex items-center gap-3 px-4 py-1.5 bg-[#D4FF00] text-[#050608] font-mono-tech font-extrabold text-xs uppercase tracking-widest -rotate-1 shadow-[4px_4px_0px_#B026FF]">
              <span>⚡ AWWWARDS NOMINATED DIGITAL LAB</span>
            </div>
            <div class="font-mono-tech text-xs text-[#00F5FF] tracking-widest uppercase flex items-center gap-2">
              <span class="w-2 h-2 bg-[#00F5FF] rounded-full animate-ping"></span>
              <span>CYBERNETIC FIELD: WARP CURSOR • CLICK FOR HARMONIC SHOCKWAVE • 3 INTERACTIVE MODES</span>
            </div>
          </div>

          <div class="relative mt-6">
            <!-- Full-Width Unobstructed Kinetic Headline (100% Zero Overlap) -->
            <h1 class="font-syne font-extrabold uppercase select-none leading-[0.9] tracking-tighter relative z-20">
              <span class="block text-4xl sm:text-7xl lg:text-[6.8rem] text-white">
                REDEFINING THE
              </span>
              <span class="block text-5xl sm:text-8xl lg:text-[8.2rem] stroke-acid acid-glow-text lg:ml-16 -mt-1 sm:-mt-3 pointer-events-none">
                DIGITAL FRONTIER
              </span>
              <span class="block text-3xl sm:text-6xl lg:text-[5.2rem] text-white lg:ml-28 mt-1">
                WITH <span class="bg-[#B026FF] text-white px-3 sm:px-5 inline-block rotate-1 shadow-[6px_6px_0px_#D4FF00]">3D WEBGL</span> &amp;
              </span>
              <span class="block text-4xl sm:text-7xl lg:text-[6.2rem] text-[#00F5FF] cyan-glow-text -mt-1">
                CREATIVE ENGINEERING.
              </span>
            </h1>

            <!-- Harmonious 2-Column Editorial & Shader Core Grid (Zero Overlap) -->
            <div class="mt-12 lg:mt-16 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start relative z-30">
              <!-- Left Column (7 cols): Editorial Lead, CTAs & Metrics -->
              <div class="lg:col-span-7 space-y-10">
                <p class="text-base sm:text-xl text-white/85 leading-relaxed font-normal max-w-2xl border-l-4 border-[#00F5FF] pl-6">
                  We obliterate lifeless corporate templates. <strong class="text-[#D4FF00]">Vortex Digital Lab</strong> engineers kinetic brand systems, real-time 3D WebGL worlds, and ultra-responsive web platforms for category-defining pioneers.
                </p>

                <div class="flex flex-wrap items-center gap-6">
                  <a
                    href="#pricing"
                    class="inline-flex items-center gap-3 px-8 py-4 bg-[#D4FF00] text-[#050608] font-mono-tech font-black text-xs sm:text-sm uppercase tracking-wider -rotate-1 hover:rotate-0 hover:bg-[#00F5FF] transition-all shadow-[6px_6px_0px_#B026FF]"
                  >
                    <span>Configure Service Stack</span>
                    <span class="text-lg leading-none">⚡</span>
                  </a>
                  <a
                    href="#works"
                    class="inline-flex items-center gap-3 px-6 py-4 bg-transparent text-white hover:text-[#D4FF00] font-mono-tech font-bold text-xs sm:text-sm uppercase tracking-wider border-b-2 border-[#00F5FF] hover:border-[#D4FF00] transition-colors"
                  >
                    <span>Explore 3D Case Studies</span>
                    <span>↘</span>
                  </a>
                </div>

                <!-- Telemetry Metrics Row -->
                <div class="pt-6 border-t border-white/10 flex flex-wrap sm:flex-nowrap items-baseline justify-between gap-6 max-w-xl">
                  <div class="-rotate-1">
                    <div class="font-syne font-extrabold text-3xl sm:text-5xl text-[#D4FF00] acid-glow-text">38+</div>
                    <div class="font-mono-tech text-xs uppercase text-white/75 mt-1">Global Honors</div>
                  </div>
                  <div class="rotate-1">
                    <div class="font-syne font-extrabold text-3xl sm:text-5xl text-[#00F5FF] cyan-glow-text">0.38s</div>
                    <div class="font-mono-tech text-xs uppercase text-white/75 mt-1">FCP Velocity</div>
                  </div>
                  <div class="-rotate-1">
                    <div class="font-syne font-extrabold text-3xl sm:text-5xl text-[#B026FF] purple-glow-text">16</div>
                    <div class="font-mono-tech text-xs uppercase text-white/75 mt-1">Global Markets</div>
                  </div>
                </div>
              </div>

              <!-- Right Column (5 cols): Dedicated Shader Core Artifact (Zero Overlap & Minimize HUD) -->
              <div class="lg:col-span-5 w-full">
                <div id="shader-core-card" class="relative bg-gradient-to-br from-[#121521]/90 via-[#050608]/95 to-[#1b0929]/90 backdrop-blur-xl p-5 sm:p-6 border-l-4 border-[#D4FF00] shadow-[10px_10px_0px_#00F5FF] transition-all duration-300">
                  <div class="flex items-center justify-between gap-2 font-mono-tech text-[11px] text-[#D4FF00]">
                    <div class="flex items-center gap-2">
                      <span class="w-2 h-2 rounded-full bg-[#D4FF00] animate-pulse"></span>
                      <span>// REAL-TIME SHADER CORE</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                      <span class="px-2 py-0.5 bg-[#D4FF00] text-[#050608] font-extrabold">GLSL 4.5</span>
                      <button
                        type="button"
                        id="btn-toggle-shader-hud"
                        class="px-2 py-0.5 bg-white/10 hover:bg-[#00F5FF] hover:text-[#050608] text-white font-mono-tech text-[10px] uppercase transition-colors cursor-pointer"
                        title="Minimize or expand Shader HUD to view background canvas"
                      >
                        [— MINIMIZE]
                      </button>
                    </div>
                  </div>

                  <div id="shader-core-body" class="mt-3 transition-all duration-300">
                    <svg class="w-full h-44 overflow-visible" viewBox="0 0 320 190" fill="none">
                      <defs>
                        <linearGradient id="acidGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                          <stop offset="0%" stop-color="#D4FF00" stop-opacity="0.85" />
                          <stop offset="50%" stop-color="#00F5FF" stop-opacity="0.5" />
                          <stop offset="100%" stop-color="#B026FF" stop-opacity="0.85" />
                        </linearGradient>
                      </defs>
                      <ellipse cx="160" cy="95" rx="135" ry="48" transform="rotate(-18 160 95)" stroke="#D4FF00" stroke-width="1.8" stroke-dasharray="8 6" />
                      <ellipse cx="160" cy="95" rx="125" ry="42" transform="rotate(24 160 95)" stroke="#00F5FF" stroke-width="1.5" />
                      <ellipse cx="160" cy="95" rx="90" ry="75" transform="rotate(-8 160 95)" stroke="#B026FF" stroke-width="1.5" stroke-dasharray="4 4" />
                      <polygon points="160,18 228,62 204,158 116,158 92,62" stroke="url(#acidGrad)" stroke-width="2.5" fill="rgba(212, 255, 0, 0.07)" />
                      <polygon points="160,42 205,78 186,140 134,140 115,78" stroke="#00F5FF" stroke-width="1.5" fill="rgba(176, 38, 255, 0.16)" />
                      <circle cx="160" cy="95" r="10" fill="#D4FF00" />
                      <circle cx="228" cy="62" r="5" fill="#00F5FF" />
                      <circle cx="92" cy="62" r="5" fill="#B026FF" />
                    </svg>

                    <div class="mt-2 pt-2 border-t border-white/10 flex items-center justify-between text-xs font-mono-tech text-white/90">
                      <span>NO TEMPLATES. ZERO LATENCY.</span>
                      <span class="text-[#00F5FF] font-bold">99.8% CSAT</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- COUNTER-ROTATING DUAL MARQUEE -->
        <div class="relative mt-24 py-6 overflow-hidden select-none">
          <div class="bg-[#D4FF00] text-[#050608] py-3.5 -rotate-1 scale-105 shadow-[0_10px_30px_rgba(212,255,0,0.25)] relative z-20">
            <div class="marquee-track-left items-center">
              <div class="flex items-center gap-8 px-4 font-mono-tech font-black text-sm sm:text-base uppercase tracking-widest">
                <span>★ VORTEX DIGITAL LAB</span>
                <span>//</span>
                <span>3D WEB EXPERIENCES</span>
                <span>✦</span>
                <span>ALGORITHMIC BRANDING</span>
                <span>✦</span>
                <span>REAL-TIME GLSL SHADERS</span>
                <span>✦</span>
                <span>HIGH-VELOCITY CREATIVE ENGINEERING</span>
                <span>✦</span>
                <span>TOKYO • BERLIN • SAN FRANCISCO • DA NANG</span>
                <span>//</span>
              </div>
              <div class="flex items-center gap-8 px-4 font-mono-tech font-black text-sm sm:text-base uppercase tracking-widest" aria-hidden="true">
                <span>★ VORTEX DIGITAL LAB</span>
                <span>//</span>
                <span>3D WEB EXPERIENCES</span>
                <span>✦</span>
                <span>ALGORITHMIC BRANDING</span>
                <span>✦</span>
                <span>REAL-TIME GLSL SHADERS</span>
                <span>✦</span>
                <span>HIGH-VELOCITY CREATIVE ENGINEERING</span>
                <span>✦</span>
                <span>TOKYO • BERLIN • SAN FRANCISCO • DA NANG</span>
                <span>//</span>
              </div>
            </div>
          </div>

          <div class="bg-[#B026FF] text-white py-3 rotate-2 scale-105 -mt-2 shadow-[0_10px_30px_rgba(176,38,255,0.35)] relative z-10">
