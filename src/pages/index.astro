        <div class="pt-10 flex flex-col sm:flex-row items-center justify-between gap-6 font-mono text-xs text-[#EDE8DF]/55">
          <div>Â© 2026 Hat Moc Craft Roastery Da Nang. All rights reserved.</div>
          <div class="flex items-center gap-8">
            <a href="/#projects" class="text-[#A85328] hover:underline">
              â† Return to Portfolio of Dang Van Bao Tuan
            </a>
            <button id="back-to-top-btn" type="button" class="hover:text-white cursor-pointer">
