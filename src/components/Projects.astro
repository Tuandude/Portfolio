---
import type { Locale } from '../types';
import { getProfile } from '../data/profile';
import AbstractFigure from './AbstractFigure.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const profile = getProfile(lang);
---

<section id="projects" class="scroll-mt-16 sm:scroll-mt-20 border-b border-hairline py-16 sm:py-24">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 md:px-8">
    <!-- Section Header Tag as valid h2 -->
    <div class="reveal-item flex items-center justify-between border-b border-hairline pb-4 mb-12">
      <h2 class="text-xs font-mono uppercase tracking-widest text-ink-muted m-0 font-normal">
        <span class="text-accent-text font-bold">[02]</span> — {profile.ui.projects.sectionTag.replace(/^\[02\]\s*—\s*/, '')}
      </h2>
      <div class="text-[11px] font-mono text-ink-muted/80 hidden sm:block">
        {profile.ui.projects.secSub}
      </div>
    </div>

    <!-- Projects Stack / Grid -->
    <div class="flex flex-col gap-12 sm:gap-16">
      {profile.projects.map((project) => (
        <article class="reveal-item border border-hairline bg-card rounded-xs overflow-hidden transition-shadow hover:shadow-xs">
          <!-- Card Header Bar -->
          <div class="border-b border-hairline bg-paper/60 px-5 py-3 flex flex-wrap items-center justify-between gap-3 text-xs font-mono">
            <div class="flex items-center gap-3">
              <span class="font-bold text-accent-text text-sm">
                #{project.index ? String(project.index).padStart(2, '0') : project.id}
              </span>
              <span class="text-ink-muted uppercase tracking-wider">{project.category}</span>
            </div>
            
            <div class="flex items-center gap-3">
              <span class="text-ink-muted">{project.year}</span>
              <span class="h-3 w-px bg-hairline"></span>
              {project.status === 'live' ? (
                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-xs text-[11px] font-medium bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/30">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                  LIVE
                </span>
              ) : (
                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-xs text-[11px] font-medium bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/30">
                  <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                  WIP
                </span>
              )}
            </div>
          </div>

          <!-- Card Body: 12-col grid split into info & abstract figure -->
          <div class="grid grid-cols-1 lg:grid-cols-12 p-6 sm:p-8 gap-8 items-center">
            <!-- Project Information (7 cols) -->
            <div class="lg:col-span-7 flex flex-col gap-4">
              <!-- Glowing Live Demo Badge -->
              {project.demo && (
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-[11px] font-mono font-bold tracking-wider bg-accent/15 text-accent-text border border-accent/40 shadow-[0_0_14px_rgba(255,79,0,0.25)] w-fit">
                  <span class="relative flex h-2 w-2">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-accent"></span>
                  </span>
                  <span>LIVE DEMO SẢN PHẨM THỰC TẾ</span>
                </div>
              )}

              <h3 class="text-xl sm:text-2xl font-bold text-ink tracking-tight m-0">
                {project.title}
              </h3>

              <p class="text-sm sm:text-base text-ink-muted leading-relaxed font-sans">
                {project.description}
              </p>

              <!-- Tech tags -->
              <div class="flex flex-wrap gap-2 pt-1" aria-label="Tech stack">
                {project.tags.map((tag) => (
                  <span class="px-2.5 py-1 text-xs font-mono rounded-xs bg-paper text-ink border border-hairline">
                    {tag}
                  </span>
                ))}
              </div>

              <!-- Action Links: Prominent Glowing Live Demo Button & GitHub -->
              <div class="flex flex-wrap items-center gap-4 pt-4 border-t border-hairline/60">
                {project.demo && (
                  <a
                    href={project.demo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group inline-flex items-center gap-2.5 px-5 py-2.5 rounded-xs font-mono text-xs uppercase tracking-wider font-bold bg-accent text-white hover:bg-[#E04600] shadow-[0_0_18px_rgba(255,79,0,0.35)] hover:shadow-[0_0_28px_rgba(255,79,0,0.6)] hover:-translate-y-0.5 active:translate-y-0 transition-all duration-300 focus-visible:outline-accent"
                    aria-label={`Trải nghiệm Live Demo — ${project.title} (mở trong tab mới)`}
                  >
                    <span>TRẢI NGHIỆM LIVE DEMO</span>
                    <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1 font-bold">→</span>
                  </a>
                )}

                {project.github && (
                  <a
                    href={project.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xs border border-hairline hover:border-hairline-strong bg-paper/60 text-xs font-mono uppercase tracking-wider text-ink hover:text-accent transition-colors focus-visible:outline-accent"
                    aria-label={`GitHub — ${project.title} (mở trong tab mới)`}
                  >
                    <!-- GitHub SVG -->
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                      <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
                    </svg>
                    <span>{profile.ui.projects.sourceCode}</span>
                    <span aria-hidden="true" class="text-[10px]">↗</span>
                  </a>
                )}
              </div>
            </div>

            <!-- Abstract Visual Figure (5 cols) -->
            <div class="lg:col-span-5">
              {project.demo ? (
                <a
                  href={project.demo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block group/fig transition-transform duration-300 hover:scale-[1.015] focus-visible:outline-accent"
                  aria-label={`Trải nghiệm Live Demo — ${project.title} (mở trong tab mới)`}
                >
                  <AbstractFigure
                    id={project.id}
                    caption={project.figureCaption}
                    category={project.category}
                  />
                </a>
              ) : (
                <AbstractFigure
                  id={project.id}
                  caption={project.figureCaption}
                  category={project.category}
                />
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
