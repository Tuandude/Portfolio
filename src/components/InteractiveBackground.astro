---
// Interactive Background: Neural Constellation & Vector Field Canvas
// Zero dependencies, fully accessible, adapts to dark/light theme & reduced-motion.
---

<canvas
  id="interactive-canvas"
  class="fixed inset-0 pointer-events-none z-0 w-full h-full transition-opacity duration-500"
  aria-hidden="true"
></canvas>

<script>
  interface NodePoint {
    x: number;
    y: number;
    vx: number;
    vy: number;
    baseX: number;
    baseY: number;
    radius: number;
    pulse: number;
  }

  interface Ripple {
    x: number;
    y: number;
    radius: number;
    maxRadius: number;
    alpha: number;
  }

  class InteractiveBackground {
    private canvas!: HTMLCanvasElement;
    private ctx!: CanvasRenderingContext2D;
    private nodes: NodePoint[] = [];
    private ripples: Ripple[] = [];
    private width = 0;
    private height = 0;
    private dpr = 1;
    private animFrameId: number | null = null;
    private isRunning = false;
    private isDark = false;
    private mouseX = -1000;
    private mouseY = -1000;
    private mouseActive = false;
    private observer: MutationObserver | null = null;
    private resizeTimeout: number | null = null;

    constructor() {
      const el = document.getElementById('interactive-canvas') as HTMLCanvasElement | null;
      if (!el) return;
      this.canvas = el;
      const context = this.canvas.getContext('2d', { alpha: true });
      if (!context) return;
      this.ctx = context;

      this.checkReducedMotion();
    }

    private checkReducedMotion() {
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      this.updateTheme();
      this.resize();

      if (prefersReduced) {
        // Draw one static frame and do not start animation loop
        this.renderStaticFrame();
        return;
      }

      this.initEvents();
      this.start();
    }

    private updateTheme() {
      this.isDark = document.documentElement.classList.contains('dark') ||
        document.documentElement.getAttribute('data-theme') === 'dark';
    }

    private resize = () => {
      this.width = window.innerWidth;
      this.height = window.innerHeight;
      this.dpr = Math.min(window.devicePixelRatio || 1, 2);

      this.canvas.width = Math.floor(this.width * this.dpr);
      this.canvas.height = Math.floor(this.height * this.dpr);
      this.ctx.setTransform(1, 0, 0, 1, 0, 0);
      this.ctx.scale(this.dpr, this.dpr);

      this.initNodes();
    };

    private initNodes() {
      this.nodes = [];
      // Density: ~1 node per 30,000 px^2, bounded between 22 and 55 nodes
      const targetCount = Math.max(22, Math.min(55, Math.floor((this.width * this.height) / 30000)));

      for (let i = 0; i < targetCount; i++) {
        const x = Math.random() * this.width;
        const y = Math.random() * this.height;
        const angle = Math.random() * Math.PI * 2;
        const speed = 0.15 + Math.random() * 0.35; // Gentle float speed

        this.nodes.push({
          x,
          y,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed,
          baseX: x,
          baseY: y,
          radius: 1.5 + Math.random() * 1.5,
          pulse: 0,
        });
      }
    }

    private initEvents() {
      // Debounced resize
      window.addEventListener('resize', () => {
        if (this.resizeTimeout) window.clearTimeout(this.resizeTimeout);
        this.resizeTimeout = window.setTimeout(this.resize, 150);
      }, { passive: true });

      // Mouse tracking
      window.addEventListener('mousemove', (e) => {
        this.mouseX = e.clientX;
        this.mouseY = e.clientY;
        this.mouseActive = true;
      }, { passive: true });

      window.addEventListener('mouseleave', () => {
        this.mouseActive = false;
      }, { passive: true });

      // Touch tracking
      window.addEventListener('touchmove', (e) => {
        if (e.touches.length > 0) {
          this.mouseX = e.touches[0].clientX;
          this.mouseY = e.touches[0].clientY;
          this.mouseActive = true;
        }
      }, { passive: true });

      window.addEventListener('touchend', () => {
        this.mouseActive = false;
      }, { passive: true });

      // Interactive Click / Tap Ripple
      window.addEventListener('pointerdown', (e) => {
        // Only trigger ripple if clicking main page area (not interactive controls like buttons/inputs)
        const target = e.target as HTMLElement | null;
        if (target && (target.tagName === 'BUTTON' || target.tagName === 'A' || target.closest('button') || target.closest('a'))) {
          return;
        }

        this.ripples.push({
          x: e.clientX,
          y: e.clientY,
          radius: 4,
          maxRadius: Math.min(220, Math.max(120, this.width * 0.2)),
          alpha: 0.55,
        });

        // Add a gentle excitation pulse to nearby nodes
        for (const node of this.nodes) {
          const dx = node.x - e.clientX;
          const dy = node.y - e.clientY;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < 180) {
            node.pulse = Math.max(node.pulse, 1.0);
            // Gentle nudge outward
            const force = (1 - dist / 180) * 1.5;
            node.vx += (dx / (dist || 1)) * force;
            node.vy += (dy / (dist || 1)) * force;
          }
        }
      }, { passive: true });

      // Watch for theme changes (e.g. user toggles Dark/Light)
      this.observer = new MutationObserver(() => {
        this.updateTheme();
      });
      this.observer.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['class', 'data-theme'],
      });

      // Pause when tab is inactive to preserve battery & CPU
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          this.stop();
        } else {
          this.start();
        }
      });
    }

    private start() {
      if (this.isRunning) return;
      this.isRunning = true;
      this.loop();
    }

    private stop() {
      this.isRunning = false;
      if (this.animFrameId !== null) {
        cancelAnimationFrame(this.animFrameId);
        this.animFrameId = null;
      }
    }

    private renderStaticFrame() {
      this.ctx.clearRect(0, 0, this.width, this.height);
      const nodeColor = this.isDark ? 'rgba(244, 241, 234, 0.22)' : 'rgba(20, 20, 20, 0.18)';
      const lineColor = this.isDark ? 'rgba(244, 241, 234, 0.06)' : 'rgba(20, 20, 20, 0.05)';

      const connectionDist = 110;
      for (let i = 0; i < this.nodes.length; i++) {
        const n1 = this.nodes[i];
        for (let j = i + 1; j < this.nodes.length; j++) {
          const n2 = this.nodes[j];
          const dist = Math.hypot(n1.x - n2.x, n1.y - n2.y);
          if (dist < connectionDist) {
            this.ctx.beginPath();
            this.ctx.moveTo(n1.x, n1.y);
            this.ctx.lineTo(n2.x, n2.y);
            this.ctx.strokeStyle = lineColor;
            this.ctx.lineWidth = 1;
            this.ctx.stroke();
          }
        }
        this.ctx.beginPath();
        this.ctx.arc(n1.x, n1.y, n1.radius, 0, Math.PI * 2);
        this.ctx.fillStyle = nodeColor;
        this.ctx.fill();
      }
    }

    private loop = () => {
      if (!this.isRunning) return;

      this.updatePhysics();
      this.render();

      this.animFrameId = requestAnimationFrame(this.loop);
    };

    private updatePhysics() {
      const mouseRadius = 140;

      // Update ripples
      for (let i = this.ripples.length - 1; i >= 0; i--) {
        const r = this.ripples[i];
        r.radius += 3.5;
        r.alpha *= 0.94;
        if (r.alpha < 0.01 || r.radius >= r.maxRadius) {
          this.ripples.splice(i, 1);
        }
      }

      // Update nodes
      for (const node of this.nodes) {
        // Natural drift
        node.x += node.vx;
        node.y += node.vy;

        // Velocity damping towards base speed
        node.vx *= 0.985;
        node.vy *= 0.985;

        // Restore minimum drift speed if slow
        const speed = Math.hypot(node.vx, node.vy);
        if (speed < 0.15) {
          const angle = Math.random() * Math.PI * 2;
          node.vx += Math.cos(angle) * 0.05;
          node.vy += Math.sin(angle) * 0.05;
        }

        // Screen boundary wrap with smooth margin
        const margin = 20;
        if (node.x < -margin) node.x = this.width + margin;
        if (node.x > this.width + margin) node.x = -margin;
        if (node.y < -margin) node.y = this.height + margin;
        if (node.y > this.height + margin) node.y = -margin;

        // Pulse decay
        if (node.pulse > 0) {
          node.pulse = Math.max(0, node.pulse - 0.02);
        }

        // Mouse attraction/gravity
        if (this.mouseActive) {
          const dx = this.mouseX - node.x;
          const dy = this.mouseY - node.y;
          const dist = Math.hypot(dx, dy);

          if (dist < mouseRadius && dist > 1) {
            const pullForce = (1 - dist / mouseRadius) * 0.25;
            node.vx += (dx / dist) * pullForce;
            node.vy += (dy / dist) * pullForce;
          }
        }
      }
    }

    private render() {
      this.ctx.clearRect(0, 0, this.width, this.height);

      // Color tokens
      const nodeColor = this.isDark ? 'rgba(244, 241, 234, 0.22)' : 'rgba(20, 20, 20, 0.18)';
      const nodePulseColor = this.isDark ? 'rgba(255, 117, 54, 0.75)' : 'rgba(255, 79, 0, 0.7)';
      const interLineBaseAlpha = this.isDark ? 0.12 : 0.09;
      const mouseLineBaseAlpha = this.isDark ? 0.35 : 0.3;
      const accentStroke = this.isDark ? '#FF7536' : '#FF4F00';
      const connectionDist = 110;
      const mouseDistThreshold = 145;

      // 1. Draw ripples
      for (const r of this.ripples) {
        this.ctx.beginPath();
        this.ctx.arc(r.x, r.y, r.radius, 0, Math.PI * 2);
        this.ctx.strokeStyle = this.isDark
          ? `rgba(255, 117, 54, ${r.alpha})`
          : `rgba(255, 79, 0, ${r.alpha})`;
        this.ctx.lineWidth = 1;
        this.ctx.stroke();
      }

      // 2. Draw inter-node connections
      for (let i = 0; i < this.nodes.length; i++) {
        const n1 = this.nodes[i];
        for (let j = i + 1; j < this.nodes.length; j++) {
          const n2 = this.nodes[j];
          const dist = Math.hypot(n1.x - n2.x, n1.y - n2.y);

          if (dist < connectionDist) {
            const alpha = (1 - dist / connectionDist) * interLineBaseAlpha;
            this.ctx.beginPath();
            this.ctx.moveTo(n1.x, n1.y);
            this.ctx.lineTo(n2.x, n2.y);
            this.ctx.strokeStyle = this.isDark
              ? `rgba(244, 241, 234, ${alpha})`
              : `rgba(20, 20, 20, ${alpha})`;
            this.ctx.lineWidth = 1;
            this.ctx.stroke();
          }
        }
      }

      // 3. Draw mouse cursor connection lines
      if (this.mouseActive) {
        for (const node of this.nodes) {
          const dist = Math.hypot(this.mouseX - node.x, this.mouseY - node.y);
          if (dist < mouseDistThreshold) {
            const alpha = (1 - dist / mouseDistThreshold) * mouseLineBaseAlpha;
            this.ctx.beginPath();
            this.ctx.moveTo(this.mouseX, this.mouseY);
            this.ctx.lineTo(node.x, node.y);
            this.ctx.strokeStyle = this.isDark
              ? `rgba(255, 117, 54, ${alpha})`
              : `rgba(255, 79, 0, ${alpha})`;
            this.ctx.lineWidth = 1;
            this.ctx.stroke();
          }
        }

        // Subtle cursor indicator dot
        this.ctx.beginPath();
        this.ctx.arc(this.mouseX, this.mouseY, 2.5, 0, Math.PI * 2);
        this.ctx.fillStyle = accentStroke;
        this.ctx.fill();
      }

      // 4. Draw nodes
      for (const node of this.nodes) {
        const currentRadius = node.radius + node.pulse * 2;
        this.ctx.beginPath();
        this.ctx.arc(node.x, node.y, currentRadius, 0, Math.PI * 2);

        if (node.pulse > 0.05) {
          this.ctx.fillStyle = nodePulseColor;
        } else {
          this.ctx.fillStyle = nodeColor;
        }
        this.ctx.fill();
      }
    }
  }

  // Initialize once DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => new InteractiveBackground());
  } else {
    new InteractiveBackground();
  }
</script>
