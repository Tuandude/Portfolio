---
import type { Locale } from '../types';
import { getProfile } from '../data/profile';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const profile = getProfile(lang);
---

<section id="about" class="scroll-mt-16 sm:scroll-mt-20 border-b border-hairline py-16 sm:py-24">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 md:px-8">
    <!-- Section Header Tag -->
    <div class="reveal-item flex items-center justify-between border-b border-hairline pb-4 mb-10">
      <div class="text-xs font-mono uppercase tracking-widest text-ink-muted">
        <span class="text-accent-text font-bold">[01]</span> — {profile.ui.about.sectionTag.replace(/^\[01\]\s*—\s*/, '')}
      </div>
      <div class="text-[11px] font-mono text-ink-muted/80 hidden sm:block">
        {profile.ui.about.secSub}
      </div>
    </div>

    <!-- 12-column Swiss grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12">
      <!-- Left Column: Bio Narrative (7 cols) -->
      <div class="reveal-item lg:col-span-7 flex flex-col gap-6">
        <h2 class="text-2xl sm:text-3xl font-bold text-ink tracking-tight">
          {profile.ui.about.heading}
        </h2>
        
        <div class="space-y-4 text-ink-muted leading-relaxed text-base sm:text-lg">
          {profile.bio.map((para) => (
            <p>{para}</p>
          ))}
        </div>

        <div class="p-4 rounded-xs border border-hairline bg-card/80 flex items-start gap-3 mt-2">
          <span class="text-accent-text font-mono text-base font-bold leading-none select-none">§</span>
          <div class="text-xs font-mono text-ink leading-relaxed">
            <span class="font-semibold uppercase tracking-wider text-accent-text block mb-1">
              {profile.ui.about.goalLabel}
            </span>
            {profile.currently}
          </div>
        </div>
      </div>

      <!-- Right Column: Spec Sheet Table (5 cols) -->
      <div class="reveal-item lg:col-span-5">
        <div class="border border-hairline bg-card rounded-xs overflow-hidden">
          <div class="bg-paper px-4 py-3 border-b border-hairline flex items-center justify-between">
            <span class="text-xs font-mono font-bold uppercase tracking-wider text-ink">
              {profile.ui.about.specSheetTitle}
            </span>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded-xs bg-ink/5 dark:bg-paper/10 text-ink-muted">
              {profile.ui.about.specSheetBadge}
            </span>
          </div>

          <div class="divide-y divide-hairline text-xs font-mono">
            <!-- Education Field -->
            <div class="p-4 space-y-1">
              <div class="text-ink-muted/80 uppercase tracking-wider text-[11px]">{profile.ui.about.eduLabel}</div>
              <div class="text-ink font-semibold">{profile.education.major}</div>
              <div class="text-ink-muted">{profile.education.year}</div>
              <div class="text-ink-muted/80 text-[11px]">{profile.ui.about.schoolLabel} {profile.education.school}</div>
            </div>

            <!-- Location Field -->
            <div class="p-4 space-y-1">
              <div class="text-ink-muted/80 uppercase tracking-wider text-[11px]">{profile.ui.about.locLabel}</div>
              <div class="text-ink font-semibold">{profile.location}</div>
            </div>

            <!-- Focus Field -->
            <div class="p-4 space-y-1">
              <div class="text-ink-muted/80 uppercase tracking-wider text-[11px]">{profile.ui.about.focusLabel}</div>
              <div class="text-ink font-semibold">{profile.ui.about.focusValue}</div>
              <div class="text-ink-muted text-[11px]">{profile.ui.about.focusSub}</div>
            </div>

            <!-- Status Field -->
            <div class="p-4 space-y-1">
              <div class="text-ink-muted/80 uppercase tracking-wider text-[11px]">{profile.ui.about.statusLabel}</div>
              <div class="text-accent-text font-semibold flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-accent inline-block"></span>
                <span>{profile.ui.about.statusValue}</span>
              </div>
            </div>

            <!-- Contact quick info -->
            <div class="p-4 space-y-1 bg-paper/30">
              <div class="text-ink-muted/80 uppercase tracking-wider text-[11px]">{profile.ui.about.directReachLabel}</div>
              <div class="text-ink truncate font-mono select-all">{profile.email}</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
