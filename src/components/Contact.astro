---
import type { Locale } from '../types';
import { getProfile } from '../data/profile';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const profile = getProfile(lang);
---

<section id="contact" class="scroll-mt-16 sm:scroll-mt-20 border-b border-hairline py-16 sm:py-24 bg-graph-grid">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 md:px-8">
    <!-- Section Header Tag as valid h2 -->
    <div class="reveal-item flex items-center justify-between border-b border-hairline pb-4 mb-12">
      <h2 class="text-xs font-mono uppercase tracking-widest text-ink-muted m-0 font-normal">
        <span class="text-accent-text font-bold">[04]</span> — {profile.ui.contact.sectionTag.replace(/^\[04\]\s*—\s*/, '')}
      </h2>
      <div class="text-[11px] font-mono text-ink-muted/80 hidden sm:block">
        {profile.ui.contact.secSub}
      </div>
    </div>

    <!-- Contact Container -->
    <div class="reveal-item max-w-3xl flex flex-col gap-8">
      <div>
        <h3 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-ink leading-[1.15] mb-4 m-0">
          {profile.ui.contact.heading}
        </h3>
        <p class="text-base sm:text-lg text-ink-muted leading-relaxed font-sans mt-2">
          {profile.ui.contact.intro}
        </p>
      </div>

      <!-- Big Email Box & Copy Button -->
      <div class="border border-hairline bg-card p-6 sm:p-8 rounded-xs">
        <div class="text-xs font-mono uppercase tracking-wider text-ink-muted mb-2 flex items-center justify-between">
          <span>{profile.ui.contact.emailLabel}</span>
          <span class="text-[11px] text-accent-text font-semibold">{profile.ui.contact.directReach}</span>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-2">
          <!-- Clickable / selectable email text -->
          <a
            href={`mailto:${profile.email}`}
            class="text-xl sm:text-2xl md:text-3xl font-mono font-bold text-ink hover:text-accent transition-colors break-all focus-visible:outline-accent"
          >
            {profile.email}
          </a>

          <!-- Copy Button -->
          <div class="flex items-center gap-3">
            <button
              id="copy-email-btn"
              type="button"
              data-email={profile.email}
              data-text-copied={profile.ui.contact.copied}
              data-text-default={profile.ui.contact.copyEmail}
              data-text-live={profile.ui.contact.copiedLive}
              data-prompt-manual={profile.ui.contact.manualCopyPrompt}
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xs bg-ink text-paper text-xs font-mono uppercase tracking-wider hover:bg-accent transition-colors focus-visible:outline-accent cursor-pointer shrink-0"
              aria-label={profile.ui.contact.copyEmail}
            >
              <!-- Clipboard SVG -->
              <svg id="copy-icon" class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2" />
              </svg>
              <!-- Check SVG (hidden initially) -->
              <svg id="check-icon" class="w-4 h-4 hidden text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span id="copy-btn-text">{profile.ui.contact.copyEmail}</span>
            </button>
          </div>
        </div>

        <!-- Live announcement for screen readers -->
        <div id="copy-feedback-live" class="sr-only" aria-live="polite"></div>
      </div>

      <!-- Social Links List -->
      <div class="pt-4">
        <div class="text-xs font-mono uppercase tracking-wider text-ink-muted mb-4">
          {profile.ui.contact.socialsTitle}
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {profile.socials.map((social) => {
            const isMail = social.url.startsWith('mailto:');
            const ariaLabel = isMail
              ? `${social.name} — ${social.label}`
              : `${social.name} — ${social.label} (mở trong tab mới)`;

            return (
              <a
                href={social.url}
                target={isMail ? undefined : '_blank'}
                rel={isMail ? undefined : 'noopener noreferrer'}
                class="border border-hairline bg-card hover:bg-paper hover:border-accent p-4 rounded-xs flex items-center justify-between group transition-colors focus-visible:outline-accent"
                aria-label={ariaLabel}
              >
                <div class="flex items-center gap-3">
                  {social.icon === 'github' && (
                    <svg class="w-4 h-4 fill-current text-ink group-hover:text-accent transition-colors" viewBox="0 0 24 24" aria-hidden="true">
                      <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
                    </svg>
                  )}
                  {social.icon === 'linkedin' && (
                    <svg class="w-4 h-4 fill-current text-ink group-hover:text-accent transition-colors" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76a1.64 1.64 0 1 0 0-3.28 1.64 1.64 0 0 0 0 3.28m1.39 9.74v-8.37H5.07v8.37h2.78Z"/>
                    </svg>
                  )}
                  {social.icon === 'email' && (
                    <svg class="w-4 h-4 text-ink group-hover:text-accent transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                  )}
                  <span class="text-xs font-mono font-medium text-ink group-hover:text-accent transition-colors">
                    {social.name}
                  </span>
                </div>
                <span class="text-ink-muted/50 group-hover:text-accent text-xs font-mono transition-colors">
                  ↗
                </span>
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  let resetTimer: ReturnType<typeof setTimeout> | null = null;

  async function copyToClipboard(text: string): Promise<boolean> {
    if (navigator.clipboard && window.isSecureContext) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        // Continue to fallback
      }
    }

    try {
      const textArea = document.createElement('textarea');
      textArea.value = text;
      textArea.style.position = 'fixed';
      textArea.style.left = '-9999px';
      textArea.style.top = '-9999px';
      textArea.setAttribute('readonly', '');
      document.body.appendChild(textArea);
      textArea.focus();
      textArea.select();

      const doc = document as unknown as { execCommand?(cmd: string): boolean };
      const success = typeof doc.execCommand === 'function' ? doc.execCommand('copy') : false;
      document.body.removeChild(textArea);
      return success;
    } catch {
      return false;
    }
  }

  const copyBtn = document.getElementById('copy-email-btn');
  const copyBtnText = document.getElementById('copy-btn-text');
  const copyIcon = document.getElementById('copy-icon');
  const checkIcon = document.getElementById('check-icon');
  const liveFeedback = document.getElementById('copy-feedback-live');

  copyBtn?.addEventListener('click', async () => {
    const email = copyBtn.getAttribute('data-email');
    if (!email) return;

    const textCopied = copyBtn.getAttribute('data-text-copied') || 'Đã sao chép!';
    const textDefault = copyBtn.getAttribute('data-text-default') || 'Sao chép email';
    const textLive = copyBtn.getAttribute('data-text-live') || 'Đã sao chép địa chỉ email vào bộ nhớ tạm.';
    const promptManual = copyBtn.getAttribute('data-prompt-manual') || 'Sao chép email thủ công:';

    const success = await copyToClipboard(email);

    if (success) {
      if (resetTimer) {
        clearTimeout(resetTimer);
        resetTimer = null;
      }

      if (copyBtnText) copyBtnText.textContent = textCopied;
      copyIcon?.classList.add('hidden');
      checkIcon?.classList.remove('hidden');
      copyBtn.classList.add('bg-emerald-700');
      copyBtn.classList.remove('bg-ink');
      if (liveFeedback) liveFeedback.textContent = textLive;

      resetTimer = setTimeout(() => {
        if (copyBtnText) copyBtnText.textContent = textDefault;
        copyIcon?.classList.remove('hidden');
        checkIcon?.classList.add('hidden');
        copyBtn.classList.remove('bg-emerald-700');
        copyBtn.classList.add('bg-ink');
        if (liveFeedback) liveFeedback.textContent = '';
        resetTimer = null;
      }, 2500);
    } else {
      // Honest fallback: do NOT show success styling if copy failed
      window.prompt(promptManual, email);
    }
  });
</script>
